# ==========================================================
# finanzas-telegram — variables de entorno (PLANTILLA)
# NO poner secretos reales aquí. Copiar a .env (gitignored).
# Los secretos con soporte nativo en n8n van en Credentials,
# NO en variables de entorno. Ver docs/security.md §3.
# ==========================================================

# ---------- n8n (self-hosted) ----------
N8N_HOST=no-26feb-n8n.ydlmwq.easypanel.host
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://no-26feb-n8n.ydlmwq.easypanel.host
WEBHOOK_URL=https://no-26feb-n8n.ydlmwq.easypanel.host
GENERIC_TIMEZONE=America/Bogota
N8N_DEFAULT_TIMEZONE=America/Bogota

# API de n8n — solo para scripts locales de import/export.
# No la consume ningún workflow. Guardar en Bitwarden.
N8N_API_URL=https://no-26feb-n8n.ydlmwq.easypanel.host/api/v1
N8N_API_KEY=

# ---------- Telegram ----------
# TELEGRAM_BOT_TOKEN vive en n8n Credentials (Telegram API).
# Aquí solo se declara para scripts locales de setup del bot.
TELEGRAM_BOT_TOKEN=
# Lista separada por comas de user_id numéricos autorizados.
# Fuente de verdad operativa = hoja Configuracion (clave autorizados_user_ids).
# Esta variable es el fallback de arranque en frío.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_CHAT_ID=
# Secreto del webhook de Telegram (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# ---------- Google ----------
GOOGLE_SHEETS_DOCUMENT_ID=
# Carpeta privada de Drive para adjuntos. Vacío = no se persisten archivos.
GOOGLE_DRIVE_FOLDER_ID=

# ---------- IA / OCR ----------
# openai | anthropic | google
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL_TEXT=gpt-5
AI_MODEL_VISION=gpt-5
AI_CONFIDENCE_THRESHOLD=0.80
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=45000

# ---------- Localización ----------
DEFAULT_CURRENCY=COP
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LANGUAGE=es-CO

# ---------- Ciclos y presupuesto (defaults; la hoja manda) ----------
CICLO_MODELO=A
CICLO_DIAS_INICIO=1,16
PRESUPUESTO_CICLO_COP=4000000

# ---------- Resúmenes programados ----------
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=20
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=19

# ---------- Límites de archivos ----------
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
