      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Marca 'expirado' todo pendiente 'abierto' cuya fecha_expiracion ya paso.\n// Purga (no se reescribe, solo se detecta) los de mas de 7 dias para que\n// el reporte de /pendientes no crezca sin limite (data-model.md §11).\nconst ZONA = 'America/Bogota';\nconst ahora = DateTime.now().setZone(ZONA);\nconst filas = $input.all().map(i => i.json);\n\nconst aExpirar = filas.filter(p =>\n  String(p.estado).trim() === 'abierto' &&\n  DateTime.fromISO(String(p.fecha_expiracion || ''), { zone: ZONA }) < ahora\n);\n\nreturn aExpirar.map(p => ({ json: { pendiente_id: p.pendiente_id, estado: 'expirado' } }));"
      },
