        "jsCode": "// Arma el rango exacto a actualizar para este pendiente (mismo patron\n// read-modify-write de DEC-016, reutilizando la lectura ya hecha arriba).\nconst HEADERS = [\"pendiente_id\",\"telegram_chat_id\",\"telegram_message_id\",\"estado_maquina\",\"datos_propuestos\",\"campo_ambiguo\",\"opciones\",\"fecha_creacion\",\"fecha_expiracion\",\"estado\",\"correlation_id\"];\nconst filas = $('Leer Pendientes').all().map(i => i.json);\nconst nuevo = $json;\nconst idx = filas.findIndex(f => String(f.pendiente_id).trim() === String(nuevo.pendiente_id).trim());\nif (idx === -1) { return { json: { _sin_fila: true } }; }\nconst filaSheets = idx + 2;\nconst fusionada = { ...filas[idx], ...nuevo };\nconst valores = HEADERS.map(h => fusionada[h] !== undefined && fusionada[h] !== null ? fusionada[h] : '');\nreturn { json: { fila_sheets: filaSheets, valores } };"
      },
