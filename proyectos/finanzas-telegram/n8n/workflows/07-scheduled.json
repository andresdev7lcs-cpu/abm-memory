    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Resumen semanal: total gastado, comparacion con la semana previa,\n// top 3 categorias, gastos inusuales, disponible restante, proximo\n// ingreso (architecture.md §19).\nconst ZONA = 'America/Bogota';\nconst ahora = DateTime.now().setZone(ZONA);\n\nconst todo = $input.all().map(i => i.json);\nconst cfg = $('Evaluar Disparo').first().json;\nconst txs = todo.filter(x => x.transaccion_id);\nconst cats = todo.filter(x => x.categoria_id);\n\nconst inicioSemana = ahora.minus({ days: ahora.weekday - 1 }).startOf('day');\nconst inicioSemanaAnt = inicioSemana.minus({ weeks: 1 });\n\nfunction sumaEnRango(desde, hasta) {\n  return txs\n    .filter(t => String(t.estado).trim() === 'activo' && t.tipo === 'gasto')\n    .filter(t => {\n      const f = DateTime.fromISO(String(t.fecha_movimiento), { zone: ZONA });\n      return f >= desde && f < hasta;\n    })\n    .reduce((a, t) => a + (Number(t.monto) || 0), 0);\n}\n\nconst totalSemana = sumaEnRango(inicioSemana, ahora.plus({ days: 1 }));\nconst totalSemanaAnt = sumaEnRango(inicioSemanaAnt, inicioSemana);\nconst variacion = totalSemanaAnt === 0 ? null : Math.round(((totalSemana - totalSemanaAnt) / totalSemanaAnt) * 1000) / 10;\n\n// top categorias de la semana\nconst porCategoria = {};\nfor (const t of txs) {\n  if (String(t.estado).trim() !== 'activo' || t.tipo !== 'gasto') continue;\n  const f = DateTime.fromISO(String(t.fecha_movimiento), { zone: ZONA });\n  if (f < inicioSemana) continue;\n  porCategoria[t.categoria] = (porCategoria[t.categoria] || 0) + (Number(t.monto) || 0);\n}\nconst top = Object.entries(porCategoria).sort((a, b) => b[1] - a[1]).slice(0, 3);\n\nconst disponibleGlobal = cats.filter(c => String(c.activa).toUpperCase() === 'TRUE')\n  .reduce((a, c) => a + (Number(c.disponible) || 0), 0);\n\nreturn [{\n  json: {\n    total_semana: totalSemana,\n    total_semana_anterior: totalSemanaAnt,\n    variacion_pct: variacion,\n    top_categorias: top,\n    disponible_global: disponibleGlobal,\n    admin_chat_id: cfg.admin_chat_id || ''\n  }\n}];"
      },
      "id": "g7000001-0000-4000-8000-000000000016",
      "name": "Calcular Resumen Semanal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $json; const fmt = v => '$' + Math.round(Number(v) || 0).toLocaleString('es-CO');\nconst L = ['📊 Resumen semanal', ''];\nL.push(`Gastado esta semana: ${fmt(s.total_semana)}`);\nif (s.variacion_pct !== null) {\n  const icono = s.variacion_pct > 0 ? '📈' : '📉';\n  L.push(`${icono} ${s.variacion_pct > 0 ? '+' : ''}${s.variacion_pct}% vs semana anterior`);\n}\nif (s.top_categorias.length) {\n  L.push('', 'Principales categorías:');\n  for (const [nombre, monto] of s.top_categorias) L.push(`• ${nombre}: ${fmt(monto)}`);\n}\nL.push('', `Disponible global: ${fmt(s.disponible_global)}`);\nreturn [{ json: { chat_id: s.admin_chat_id, texto: L.join('\\n') } }];"
      },
