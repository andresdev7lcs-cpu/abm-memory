        "jsCode": "// Marca 'vencido' un ingreso 'pendiente' cuya proxima_fecha ya paso.\n// Alerta INGRESO_VENCIDO (architecture.md §11), una vez por ingreso por\n// vencimiento (dedupe simple: solo actua si el estado no es ya 'vencido').\nconst ZONA = 'America/Bogota';\nconst ahora = DateTime.now().setZone(ZONA).startOf('day');\nconst ingresos = $input.all().filter(i => i.json && i.json.ingreso_id).map(i => i.json);\nconst cfg = {};\nfor (const f of $input.all()) if (f.json && f.json.clave) cfg[f.json.clave] = f.json.valor;\n\nconst vencidos = ingresos.filter(i =>\n  String(i.estado).trim() === 'pendiente' &&\n  DateTime.fromISO(String(i.proxima_fecha || ''), { zone: ZONA }) < ahora\n);\n\nreturn vencidos.map(i => ({\n  json: {\n    ingreso_id: i.ingreso_id,\n    estado: 'vencido',\n    _admin_chat_id: cfg.admin_chat_id || '',\n    _nombre: i.nombre,\n    _monto: i.monto_esperado,\n    _fecha: i.proxima_fecha\n  }\n}));"
      },
