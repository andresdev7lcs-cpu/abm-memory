    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Decide si CORRE algo en esta hora exacta: resumen semanal (dia+hora\n// configurados) y/o deteccion de cierre de ciclo (ejecuta siempre, es\n// barata: comparar el ciclo de ayer contra el de hoy).\nconst ZONA = 'America/Bogota';\nconst ahora = DateTime.now().setZone(ZONA);\nconst cfg = {};\nfor (const f of $input.all()) if (f.json && f.json.clave) cfg[f.json.clave] = f.json.valor;\n\nconst resumenActivo = String(cfg.resumen_semanal_activo || 'FALSE').toUpperCase() === 'TRUE';\nconst diaObjetivo = parseInt(cfg.dia_resumen_semanal || '0', 10);\nconst horaObjetivo = String(cfg.hora_envio_resumen || '20:00').split(':')[0];\n\n// Luxon: weekday 1=lunes..7=domingo. dia_resumen_semanal usa 0=domingo.\nconst diaLuxon = diaObjetivo === 0 ? 7 : diaObjetivo;\nconst esHoraDelResumen = resumenActivo && ahora.weekday === diaLuxon && String(ahora.hour) === horaObjetivo;\n\nreturn [{ json: { ...cfg, _correr_resumen: esHoraDelResumen, _hoy: ahora.toISODate() } }];"
      },
