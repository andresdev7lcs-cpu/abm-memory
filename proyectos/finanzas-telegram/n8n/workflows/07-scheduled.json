        "jsCode": "const HEADERS = [\"ingreso_id\",\"nombre\",\"monto_esperado\",\"monto_recibido\",\"frecuencia\",\"dia_programado\",\"proxima_fecha\",\"fecha_recibido\",\"estado\",\"categorias_asociadas\",\"notas\"];\nconst filas = $('Leer Ingresos').all().map(i => i.json);\nconst nuevo = $json;\nconst idx = filas.findIndex(f => String(f.ingreso_id).trim() === String(nuevo.ingreso_id).trim());\nif (idx === -1) { return { json: { _sin_fila: true } }; }\nconst filaSheets = idx + 2;\nconst fusionada = { ...filas[idx], estado: nuevo.estado };\nconst valores = HEADERS.map(h => fusionada[h] !== undefined && fusionada[h] !== null ? fusionada[h] : '');\nreturn { json: { fila_sheets: filaSheets, valores, _admin_chat_id: nuevo._admin_chat_id, _nombre: nuevo._nombre, _monto: nuevo._monto, _fecha: nuevo._fecha } };"
