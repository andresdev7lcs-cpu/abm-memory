    {
      "parameters": {
        "jsCode": "// Autorizacion. Fail-closed: lista vacia = nadie entra (security.md §2).\n//\n// Fuente de verdad: hoja Configuracion.\n// Respaldo de arranque en frio: TELEGRAM_ALLOWED_USER_IDS, solo si la\n// hoja no respondio.\n\nconst sobre = $('Validar Origen y Deduplicar').first().json;\nconst filas = $input.all().map(i => i.json).filter(r => r && r.clave);\n\nconst cfg = {};\nfor (const f of filas) cfg[String(f.clave).trim()] = String(f.valor ?? '').trim();\n\nconst hojaRespondio = filas.length > 0;\nconst crudo = hojaRespondio\n  ? (cfg.autorizados_user_ids || '')\n  : ($env.TELEGRAM_ALLOWED_USER_IDS || '');\n\nconst autorizados = crudo.split(',').map(s => s.trim()).filter(Boolean);\nconst userId = String(sobre.ctx.telegram_user_id ?? '');\nconst autorizado = autorizados.length > 0 && autorizados.includes(userId);\n\nreturn [{\n  json: {\n    ...sobre,\n    _autorizado: autorizado,\n    _fuente_allowlist: hojaRespondio ? 'hoja' : 'env',\n    ctx: {\n      ...sobre.ctx,\n      es_admin: userId !== '' && userId === (cfg.admin_chat_id || '')\n    },\n    config: cfg\n  }\n}];"
      },
