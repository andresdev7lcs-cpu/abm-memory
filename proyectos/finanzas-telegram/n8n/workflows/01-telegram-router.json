      "parameters": {
        "jsCode": "// Puerta de entrada. Tres cosas, en este orden:\n//   1. Validar que el update viene de Telegram (secret token).\n//   2. Descartar updates repetidos (idempotencia, architecture.md §9).\n//   3. Normalizar el sobre {meta, ctx, payload} que consumen WF2..WF6.\n//\n// Todavia NO se autoriza al usuario: eso necesita leer la hoja\n// Configuracion y no queremos esa latencia antes de responderle 200\n// a Telegram.\n\nconst SECRETO = '__TELEGRAM_WEBHOOK_SECRET__';\nconst headers = $json.headers || {};\nconst recibido = headers['x-telegram-bot-api-secret-token'] || '';\n\n// Comparacion de longitud constante: evita filtrar el secreto por tiempo.\nfunction iguales(a, b) {\n  if (a.length !== b.length) return false;\n  let dif = 0;\n  for (let i = 0; i < a.length; i++) dif |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return dif === 0;\n}\n\nconst origenValido = SECRETO.length > 0 && iguales(SECRETO, String(recibido));\n\nif (!origenValido) {\n  return [{ json: { _origen_valido: false, _duplicado: false } }];\n}\n\nconst update = $json.body || {};\nconst updateId = update.update_id;\n\n// Dedupe: los ultimos 500 update_id sobreviven entre ejecuciones.\nconst estado = $getWorkflowStaticData('global');\nif (!Array.isArray(estado.updateIds)) estado.updateIds = [];\n\nif (updateId !== undefined && estado.updateIds.includes(updateId)) {\n  return [{ json: { _origen_valido: true, _duplicado: true, _update_id: updateId } }];\n}\nif (updateId !== undefined) {\n  estado.updateIds.push(updateId);\n  if (estado.updateIds.length > 500) estado.updateIds = estado.updateIds.slice(-500);\n}\n\n// --- Normalizacion ---\nconst msg = update.message || update.edited_message || null;\nconst cb = update.callback_query || null;\nconst from = (msg && msg.from) || (cb && cb.from) || {};\nconst chat = (msg && msg.chat) || (cb && cb.message && cb.message.chat) || {};\n\nlet tipo = 'desconocido';\nlet texto = '';\nlet fileId = null;\nlet mime = null;\nlet fileSize = null;\n\nif (cb) {\n  tipo = 'callback';\n  texto = cb.data || '';\n} else if (msg) {\n  if (msg.photo && msg.photo.length) {\n    tipo = 'imagen';\n    const mayor = msg.photo[msg.photo.length - 1]; // la ultima es la de mayor resolucion\n    fileId = mayor.file_id;\n    fileSize = mayor.file_size || null;\n    mime = 'image/jpeg';\n    texto = msg.caption || '';\n  } else if (msg.document) {\n    tipo = 'documento';\n    fileId = msg.document.file_id;\n    mime = msg.document.mime_type || null;\n    fileSize = msg.document.file_size || null;\n    texto = msg.caption || '';\n  } else if (msg.voice || msg.audio) {\n    tipo = 'audio';\n    const a = msg.voice || msg.audio;\n    fileId = a.file_id;\n    mime = a.mime_type || null;\n    fileSize = a.file_size || null;\n  } else if (typeof msg.text === 'string') {\n    texto = msg.text;\n    tipo = msg.text.trim().startsWith('/') ? 'comando' : 'texto';\n  }\n}\n\n// correlation_id: hilo unico para seguir la peticion en Auditoria.\nconst correlationId = [\n  Date.now().toString(36),\n  Math.random().toString(36).slice(2, 8)\n].join('-');\n\nreturn [{\n  json: {\n    _origen_valido: true,\n    _duplicado: false,\n    _tipo: tipo,\n    meta: {\n      correlation_id: correlationId,\n      execution_id: $execution.id,\n      origen: tipo === 'texto' || tipo === 'comando' ? 'telegram_texto'\n            : tipo === 'imagen'    ? 'telegram_imagen'\n            : tipo === 'documento' ? 'telegram_pdf'\n            : tipo === 'audio'     ? 'telegram_audio'\n            : 'telegram_texto',\n      recibido_en: new Date().toISOString(),\n      workflow_origen: '01-telegram-router'\n    },\n    ctx: {\n      telegram_user_id: from.id || null,\n      telegram_chat_id: chat.id || null,\n      telegram_message_id: (msg && msg.message_id) || (cb && cb.message && cb.message.message_id) || null,\n      update_id: updateId || null,\n      nombre: from.first_name || '',\n      username: from.username || '',\n      callback_query_id: cb ? cb.id : null\n    },\n    payload: {\n      tipo,\n      texto,\n      file_id: fileId,\n      mime_type: mime,\n      file_size: fileSize\n    }\n  }\n}];"
      },
