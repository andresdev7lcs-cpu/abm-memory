      "parameters": {
        "jsCode": "// Registro del intento no autorizado. Solo el user_id numerico:\n// nada de nombre, username ni texto del mensaje (security.md §7).\nconst s = $json;\nconst ahora = new Date();\nconst stamp = ahora.toISOString().slice(0, 10).replace(/-/g, '');\nconst rnd = Math.random().toString(36).slice(2, 6).toUpperCase();\n\nreturn [{\n  json: {\n    evento_id: `EV-${stamp}-${rnd}`,\n    timestamp: ahora.toISOString(),\n    correlation_id: s.meta.correlation_id,\n    workflow: '01-telegram-router',\n    ejecucion: String(s.meta.execution_id),\n    usuario: String(s.ctx.telegram_user_id ?? ''),\n    accion: 'autorizar',\n    resultado: 'warn',\n    detalle: 'Intento de acceso de usuario no autorizado',\n    error: '',\n    datos_tecnicos: JSON.stringify({\n      tipo_mensaje: s.payload.tipo,\n      fuente_allowlist: s._fuente_allowlist\n    })\n  }\n}];"
      },
