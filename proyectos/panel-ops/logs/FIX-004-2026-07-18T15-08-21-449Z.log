29\t  ]);\n430\t  card.appendChild(footer);\n431\t\n432\t  return card;\n433\t}\n434\t\n435\tfunction render() {\n436\t  const columns = {\n437\t    'To Do': document.querySelector('[data-col=\"To Do\"] .cards'),\n438\t    'In Progress': document.querySelector('[data-col=\"In Progress\"] .cards'),\n439\t    'Blocked': document.querySelector('[data-col=\"Blocked\"] .cards'),"}]},"parent_tool_use_id":null,"session_id":"f06ee260-bbaf-4bde-a1b1-9dddc1b9431e","uuid":"69b38a48-5bfc-46cb-b634-034b639cfd32","timestamp":"2026-07-18T15:08:54.799Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/tools/roadmap-dashboard/index.html","content":"}\n\nasync function loadTickets() {\n  try {\n    const data = await fetchJson('/api/tickets');\n    ticketsCache = data.tickets;\n    render();\n    document.getElementById('refresh-meta').textContent =\n      'actualizado ' + new Date().toLocaleTimeString() + ' — ' + data.count + ' tickets';\n  } catch (e) {\n    document.getElementById('refresh-meta').textContent = 'error al refrescar: ' + e.message;\n  }\n}\n\nfunction depPill(dep) {\n  return el('span', {\n    class: 'dep-pill ' + (dep.completed ? 'done' : 'pending'),\n    text: dep.id + (dep.completed ? ' ✓' : ' …'),\n  });\n}\n\nfunction buildCard(ticket) {\n  const card = el('div', { class: 'card', 'data-ticket': ticket.id });\n\n  const idRow = el('div', { class: 'id-row' }, [\n    el('span', { class: 'id', text: ticket.id }),\n    el('span', { class: 'model', text: ticket.recommendedModel }),\n  ]);\n  card.appendChild(idRow);\n\n  card.appendChild(el('div', { class: 'title', text: ticket.title }));\n  card.appendChild(el('div', { class: 'desc', text: ticket.description || '(sin objetivo)' }));\n\n  const badgeLabel = ticket.blockerType === 'blocked-external-verification'\n    ? 'bloqueado — verificación externa pendiente'\n    : ticket.rawState;\n  const badge = el('span', {\n    class: 'badge ' + ticket.rawState,\n    text: badgeLabel,\n  });\n  const depsWrap = el('div', { class: 'deps' });\n  if (ticket.dependencies.length === 0) {\n    depsWrap.appendChild(el('span', { class: 'dep-pill done', text: 'sin dependencias' }));\n  } else {\n    ticket.dependencies.forEach((d) => depsWrap.appendChild(depPill(d)));\n  }\n  card.appendChild(depsWrap);\n  card.appendChild(badge);\n\n  // Execute controls — FIX-003: human/business tickets (isHumanTask) get no\n  // runner/model selector and no Execute button, since no agent process can\n  // ever complete them; show an explanatory badge instead.\n  if (ticket.isHumanTask) {\n    card.appendChild(el('span', {\n      class: 'human-task-badge',\n      text: 'tarea humana — no ejecutable',\n    }));\n  } else if (ticket.blockerType === 'blocked-external-verification') {\n    const saved = userSelections.get(ticket.id);\n    const actions = el('div', { class: 'card-actions' });\n    const runnerSelect = el('select', { class: 'runner-select' });\n    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {\n      runnerSelect.appendChild(el('option', { value: r, text: r }));\n    });\n    if (saved && [...runnerSelect.options].some((o) => o.value === saved.runner)) {\n      runnerSelect.value = saved.runner;\n    }\n\n    const modelSelect = el('select', { class: 'model-select' });\n    function refreshModelOptions() {\n      modelSelect.innerHTML = '';\n      if (runnerSelect.value === 'claude') {\n        modelSelect.disabled = false;\n        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])\n          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));\n      } else {\n        modelSelect.disabled = true;\n        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));\n      }\n      if (saved && [...modelSelect.options].some((o) => o.value === saved.model)) {\n        modelSelect.value = saved.model;\n      }\n    }\n    function saveSelection() {\n      userSelections.set(ticket.id, { runner: runnerSelect.value, model: modelSelect.value });\n    }\n    runnerSelect.addEventListener('change', () => { refreshModelOptions(); saveSelection(); });\n    modelSelect.addEventListener('change', saveSelection);\n    refreshModelOptions();\n\n    const ackReason = el('textarea', {\n      class: 'ack-reason',\n      placeholder: '¿Qué condición externa ya está disponible y por qué ahora sí funcionará?',\n      rows: '2',\n      style: 'min-width: 100%;',\n    });\n    const ackAuthor = el('input', {\n      class: 'ack-author',\n      placeholder: 'autor humano',\n      value: 'human',\n      style: 'min-width: 180px;',\n    });\n    const relaunchBtn = el('button', {\n      class: 'primary small',\n      text: 'Reanudar con confirmación',\n      onclick: () => executeTicket(ticket.id, runnerSelect.value, modelSelect.value, {\n        humanAck: true,\n        ackReason: ackReason.value,\n        author: ackAuthor.value,\n      }),\n    });\n\n    actions.appendChild(runnerSelect);\n    actions.appendChild(modelSelect);\n    actions.appendChild(ackAuthor);\n    actions.appendChild(ackReason);\n    actions.appendChild(relaunchBtn);\n    card.appendChild(actions);\n  } else {\n    const saved = userSelections.get(ticket.id);\n    const actions = el('div', { class: 'card-actions' });\n    const runnerSelect = el('select', { class: 'runner-select' });\n    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {\n      runnerSelect.appendChild(el('option', { value: r, text: r }));\n    });\n    if (saved && [...runnerSelect.options].some((o) => o.value === saved.runner)) {\n      runnerSelect.value = saved.runner;\n    }\n\n    const modelSelect = el('select', { class: 'model-select' });\n    function refreshModelOptions() {\n      modelSelect.innerHTML = '';\n      if (runnerSelect.value === 'claude') {\n        modelSelect.disabled = false;\n        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])\n          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));\n      } else {\n        modelSelect.disabled = true;\n        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));\n      }\n      if (saved && [...modelSelect.options].some((o) => o.value === saved.model)) {\n        modelSelect.value = saved.model;\n      }\n    }\n    function saveSelection() {\n      userSelections.set(ticket.id, { runner: runnerSelect.value, model: modelSelect.value });\n    }\n    runnerSelect.addEventListener('change', () => { refreshModelOptions(); saveSelection(); });\n    modelSelect.addEventListener('change', saveSelection);\n    refreshModelOptions();\n\n    const canExecute = ticket.rawState === 'pending' || ticket.rawState === 'blocked' || ticket.rawState === 'failed';\n    const execBtn = el('button', {\n      class: 'primary small',\n      text: ticket.hasActiveRun ? 'ejecutando…' : 'Ejecutar',\n      disabled: (!canExecute || ticket.hasActiveRun) ? 'true' : null,\n      onclick: () => executeTicket(ticket.id, runnerSelect.value, modelSelect.value),\n    });\n    if (!canExecute || ticket.hasActiveRun) execBtn.disabled = true;\n\n    actions.appendChild(runnerSelect);\n    actions.appendChild(modelSelect);\n    actions.appendChild(execBtn);\n    card.appendChild(actions);\n  }\n\n  const footer = el('div', { class: 'card-footer-links' }, [\n    el('button', { class: 'link', text: 'ver log', onclick: () => openLogModal(ticket.id) }),\n    el('button', { class: 'link', text: 'comentarios', onclick: () => openCommentsModal(ticket.id) }),\n  ]);\n  card.appendChild(footer);\n\n  return card;\n}\n\nfunction render() {\n  const columns = {\n    'To Do': document.querySelector('[data-col=\"To Do\"] .cards'),\n    'In Progress': document.querySelector('[data-col=\"In Progress\"] .cards'),\n    'Blocked': document.querySelector('[data-col=\"Blocked\"] .cards'),","numLines":180,"startLine":260,"totalLines":595}}}
