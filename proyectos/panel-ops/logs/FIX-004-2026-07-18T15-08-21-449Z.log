{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WsDKYpVD9BPC74HoVwci6B","type":"tool_result","content":"260\t}\n261\t\n262\tasync function loadTickets() {\n263\t  try {\n264\t    const data = await fetchJson('/api/tickets');\n265\t    ticketsCache = data.tickets;\n266\t    render();\n267\t    document.getElementById('refresh-meta').textContent =\n268\t      'actualizado ' + new Date().toLocaleTimeString() + ' — ' + data.count + ' tickets';\n269\t  } catch (e) {\n270\t    document.getElementById('refresh-meta').textContent = 'error al refrescar: ' + e.message;\n271\t  }\n272\t}\n273\t\n274\tfunction depPill(dep) {\n275\t  return el('span', {\n276\t    class: 'dep-pill ' + (dep.completed ? 'done' : 'pending'),\n277\t    text: dep.id + (dep.completed ? ' ✓' : ' …'),\n278\t  });\n279\t}\n280\t\n281\tfunction buildCard(ticket) {\n282\t  const card = el('div', { class: 'card', 'data-ticket': ticket.id });\n283\t\n284\t  const idRow = el('div', { class: 'id-row' }, [\n285\t    el('span', { class: 'id', text: ticket.id }),\n286\t    el('span', { class: 'model', text: ticket.recommendedModel }),\n287\t  ]);\n288\t  card.appendChild(idRow);\n289\t\n290\t  card.appendChild(el('div', { class: 'title', text: ticket.title }));\n291\t  card.appendChild(el('div', { class: 'desc', text: ticket.description || '(sin objetivo)' }));\n292\t\n293\t  const badgeLabel = ticket.blockerType === 'blocked-external-verification'\n294\t    ? 'bloqueado — verificación externa pendiente'\n295\t    : ticket.rawState;\n296\t  const badge = el('span', {\n297\t    class: 'badge ' + ticket.rawState,\n298\t    text: badgeLabel,\n299\t  });\n300\t  const depsWrap = el('div', { class: 'deps' });\n301\t  if (ticket.dependencies.length === 0) {\n302\t    depsWrap.appendChild(el('span', { class: 'dep-pill done', text: 'sin dependencias' }));\n303\t  } else {\n304\t    ticket.dependencies.forEach((d) => depsWrap.appendChild(depPill(d)));\n305\t  }\n306\t  card.appendChild(depsWrap);\n307\t  card.appendChild(badge);\n308\t\n309\t  // Execute controls — FIX-003: human/business tickets (isHumanTask) get no\n310\t  // runner/model selector and no Execute button, since no agent process can\n311\t  // ever complete them; show an explanatory badge instead.\n312\t  if (ticket.isHumanTask) {\n313\t    card.appendChild(el('span', {\n314\t      class: 'human-task-badge',\n315\t      text: 'tarea humana — no ejecutable',\n316\t    }));\n317\t  } else if (ticket.blockerType === 'blocked-external-verification') {\n318\t    const saved = userSelections.get(ticket.id);\n319\t    const actions = el('div', { class: 'card-actions' });\n320\t    const runnerSelect = el('select', { class: 'runner-select' });\n321\t    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {\n322\t      runnerSelect.appendChild(el('option', { value: r, text: r }));\n323\t    });\n324\t    if (saved && [...runnerSelect.options].some((o) => o.value === saved.runner)) {\n325\t      runnerSelect.value = saved.runner;\n326\t    }\n327\t\n328\t    const modelSelect = el('select', { class: 'model-select' });\n329\t    function refreshModelOptions() {\n330\t      modelSelect.innerHTML = '';\n331\t      if (runnerSelect.value === 'claude') {\n332\t        modelSelect.disabled = false;\n333\t        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])\n334\t          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));\n335\t      } else {\n336\t        modelSelect.disabled = true;\n337\t        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));\n338\t      }\n339\t      if (saved && [...modelSelect.options].some((o) => o.value === saved.model)) {\n340\t        modelSelect.value = saved.model;\n341\t      }\n342\t    }\n343\t    function saveSelection() {\n344\t      userSelections.set(ticket.id, { runner: runnerSelect.value, model: modelSelect.value });\n345\t    }\n346\t    runnerSelect.addEventListener('change', () => { refreshModelOptions(); saveSelection(); });\n347\t    modelSelect.addEventListener('change', saveSelection);\n348\t    refreshModelOptions();\n349\t\n350\t    const ackReason = el('textarea', {\n351\t      class: 'ack-reason',\n352\t      placeholder: '¿Qué condición externa ya está disponible y por qué ahora sí funcionará?',\n353\t      rows: '2',\n354\t      style: 'min-width: 100%;',\n355\t    });\n356\t    const ackAuthor = el('input', {\n357\t      class: 'ack-author',\n358\t      placeholder: 'autor humano',\n359\t      value: 'human',\n360\t      style: 'min-width: 180px;',\n361\t    });\n362\t    const relaunchBtn = el('button', {\n363\t      class: 'primary small',\n364\t      text: 'Reanudar con confirmación',\n365\t      onclick: () => executeTicket(ticket.id, runnerSelect.value, modelSelect.value, {\n366\t        humanAck: true,\n367\t        ackReason: ackReason.value,\n368\t        author: ackAuthor.value,\n369\t      }),\n370\t    });\n371\t\n372\t    actions.appendChild(runnerSelect);\n373\t    actions.appendChild(modelSelect);\n374\t    actions.appendChild(ackAuthor);\n375\t    actions.appendChild(ackReason);\n376\t    actions.appendChild(relaunchBtn);\n377\t    card.appendChild(actions);\n378\t  } else {\n379\t    const saved = userSelections.get(ticket.id);\n380\t    const actions = el('div', { class: 'card-actions' });\n381\t    const runnerSelect = el('select', { class: 'runner-select' });\n382\t    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {\n383\t      runnerSelect.appendChild(el('option', { value: r, text: r }));\n384\t    });\n385\t    if (saved && [...runnerSelect.options].some((o) => o.value === saved.runner)) {\n386\t      runnerSelect.value = saved.runner;\n387\t    }\n388\t\n389\t    const modelSelect = el('select', { class: 'model-select' });\n390\t    function refreshModelOptions() {\n391\t      modelSelect.innerHTML = ''