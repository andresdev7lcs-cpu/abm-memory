{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H7s63DMj9jwqyduptwbGtA","type":"tool_result","content":"1\t/**\n2\t * INF-002 — Generic read/write data layer with a single locked write path.\n3\t * All table mutation goes through the helpers below to preserve atomic\n4\t * sequence increments and Activity logging.\n5\t */\n6\t\n7\tvar PANEL_OPS_ID_PREFIXES = {\n8\t  Customers: 'CUS',\n9\t  Tickets: 'ORD',\n10\t  Parts: 'PRT',\n11\t  Quotations: 'QTN',\n12\t  Quotation_Lines: 'QTL',\n13\t  Payments: 'PAY',\n14\t  Panel_Prices: 'PPR',\n15\t  Cut_Prices: 'CPR',\n16\t  Edge_Banding_Prices: 'EPR',\n17\t  Users: 'USR',\n18\t  Workflow_States: 'WFS',\n19\t  Activity: 'ACT',\n20\t  Documents: 'DOC',\n21\t  Configuration: 'CFG',\n22\t  Loss_Reasons: 'LRS',\n23\t  Imports: 'IMP'\n24\t};\n25\t\n26\tvar db = {\n27\t  read: function (tableName, filterFn) {\n28\t    var table = getTableSpec_(tableName);\n29\t    var sheet = getSheet_(tableName);\n30\t    var rows = sheet.getDataRange().getValues();\n31\t    if (rows.length <= 1) {\n32\t      return [];\n33\t    }\n34\t\n35\t    var headers = rows[0];\n36\t    var results = [];\n37\t    for (var i = 1; i < rows.length; i++) {\n38\t      var rowObject = rowToObject_(headers, rows[i]);\n39\t      if (!filterFn || filterFn(rowObject)) {\n40\t        results.push(rowObject);\n41\t      }\n42\t    }\n43\t    return results;\n44\t  },\n45\t\n46\t  insert: function (tableName, row, meta) {\n47\t    return withPanelOpsLock_(function () {\n48\t      var table = getTableSpec_(tableName);\n49\t      var sheet = getSheet_(tableName);\n50\t      var record = normalizeRowForInsert_(tableName, row);\n51\t      ensureSequenceId_(tableName, record);\n52\t      appendRow_(sheet, table.headers, record);\n53\t      activityLog_('insert', tableName, record, null, null, meta);\n54\t      return record;\n55\t    });\n56\t  },\n57\t\n58\t  update: function (tableName, matchFn, patch, meta) {\n59\t    return withPanelOpsLock_(function () {\n60\t      var table = getTableSpec_(tableName);\n61\t      var sheet = getSheet_(tableName);\n62\t      var data = sheet.getDataRange().getValues();\n63\t      if (data.length <= 1) {\n64\t        return null;\n65\t      }\n66\t\n67\t      var headers = data[0];\n68\t      for (var i = 1; i < data.length; i++) {\n69\t        var current = rowToObject_(headers, data[i]);\n70\t        if (!matchFn(current)) {\n71\t          continue;\n72\t        }\n73\t        var before = copyObject_(current);\n74\t        var updated = mergeRow_(table.headers, current, patch);\n75\t        writeRow_(sheet, i + 1, table.headers, updated);\n76\t        activityLog_('update', tableName, updated, before, patch, meta);\n77\t        return updated;\n78\t      }\n79\t      return null;\n80\t    });\n81\t  }\n82\t};\n83\t\n84\tfunction getTableSpec_(tableName) {\n85\t  for (var i = 0; i < PANEL_OPS_SCHEMA.length; i++) {\n86\t    if (PANEL_OPS_SCHEMA[i].name === tableName) {\n87\t      return PANEL_OPS_SCHEMA[i];\n88\t    }\n89\t  }\n90\t  throw new Error('Unknown table: ' + tableName);\n91\t}\n92\t\n93\tfunction getSheet_(tableName) {\n94\t  var ss = getPanelOpsSpreadsheet_();\n95\t  var sheet = ss.getSheetByName(tableName);\n96\t  if (!sheet) {\n97\t    throw new Error('Missing sheet: ' + tableName);\n98\t  }\n99\t  return sheet;\n100\t}\n101\t\n102\tfunction getPanelOpsSpreadsheet_() {\n103\t  var props = PropertiesService.getScriptProperties();\n104\t  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n105\t  if (!id) {\n106\t    throw new Error('Missing spreadsheet id property: ' + PANEL_OPS_SS_ID_PROP);\n107\t  }\n108\t  return SpreadsheetApp.openById(id);\n109\t}\n110\t\n111\tfunction withPanelOpsLock_(callback) {\n112\t  var lock = LockService.getScriptLock();\n113\t  lock.waitLock(30000);\n114\t  try {\n115\t    return callback();\n116\t  } finally {\n117\t    lock.releaseLock();\n118\t  }\n119\t}\n120\t\n121\tfunction rowToObject_(headers, values) {\n122\t  var out = {};\n123\t  for (var i = 0; i < headers.length; i++) {\n124\t    out[headers[i]] = values[i];\n125\t  }\n126\t  return out;\n127\t}\n128\t\n129\tfunction normalizeRowForInsert_(tableName, row) {\n130\t  var table = getTableSpec_(tableName);\n131\t  var normalized = {};\n132\t  table.headers.forEach(function (header) {\n133\t    if (Object.prototype.hasOwnProperty.call(row, header)) {\n134\t      normalized[header] = row[header];\n135\t    } else {\n136\t      normalized[header] = '';\n137\t    }\n138\t  });\n139\t  return normalized;\n140\t}\n141\t\n142\tfunction ensureSequenceId_(tableName, row) {\n143\t  var idField = getTableSpec_(tableName).headers[0];\n144\t  if (row[idField]) {\n145\t    return row;\n146\t  }\n147\t\n148\t  if (tableName === 'Tickets') {\n149\t    row[idField] = nextTicketId_();\n150\t    return row;\n151\t  }\n152\t\n153\t  row[idField] = nextPrefixedId_(tableName);\n154\t  return row;\n155\t}\n156\t\n157\tfunction nextPrefixedId_(tableName) {\n158\t  var seqKey = getSequenceKeyForTable_(tableName);\n159\t  var sequences = getSequenceState_();\n160\t  sequences[seqKey] = Number(sequences[seqKey] || 0) + 1;\n161\t  persistSequenceState_(sequences);\n162\t  return PANEL_OPS_ID_PREFIXES[tableName] + '-' + padNumber_(sequences[seqKey], 4);\n163\t}\n164\t\n165\tfunction nextTicketId_() {\n166\t  var sequences = getSequenceState_();\n167\t  var stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMM');\n168\t  if (!sequences.ticket_monthly) {\n169\t    sequences.ticket_monthly = {};\n170\t  }\n171\t  sequences.ticket_monthly[stamp] = Number(sequences.ticket_monthly[stamp] || 0) + 1;\n172\t  persistSequenceState_(sequences);\n173\t  return 'ORD-' + stamp + '-' + padNumber_(sequences.ticket_monthly[stamp], 4);\n174\t}\n175\t\n176\tfunction getSequenceKeyForTable_(tableName) {\n177\t  return String(tableName).replace(/[^A-Za-z0-9]/g, '_').toLowerCase();\n178\t}\n179\t\n180\tfunction getSequenceState_() {\n181\t  var config = getConfigurationMap_();\n182\t  var stored = config.sequences;\n183\t  if (stored && typeof stored === 'object') {\n184\t    return copyObject_(stored);\n185\t  }\n186\t  return copyObject_(SEQUENCES_SEED);\n187\t}\n188\t\n189\tfunction persistSequenceState_(sequences) {\n190\t  upsertConfigurationValue_('sequences', sequences, 'Contadores de secuencia por tipo de ID');\n191\t}\n192\t\n193\tfunction getConfigurationMap_() {\n194\t  var rows = db.read('Configuration');\n195\t  var map = {};\n196\t  rows.forEach(function (row) {\n197\t    map[row.key] = parseJsonValue_(row.value_json);\n198\t  });\n199\t  return map;\n200\t}\n201\t\n202\tfunction upsertConfigurationValue_(key, value, description) {\n203\t  var sheet = getSheet_('Configuration');\n204\t  var data = sheet.getDataRange().getValues();\n205\t  var now = new Date().toISOString();\n206\t  var serialized = JSON.stringify(value);\n207\t  for (var i = 1; i < data.length; i++) {\n208\t    if (data[i][0] === key) {\n209\t      sheet.getRange(i + 1, 2, 1, 4).setValues([[serialized, description || data[i][2], 'setupPanelOpsWorkbook', now]]);\n210\t      return;\n211\t    }\n212\t  }\n213\t  sheet.getRange(sheet.getLastRow() + 1, 1, 1, 5).setValues([[key, serialized, description || '', 'setupPanelOpsWorkbook', now]]);\n214\t}\n215\t\n216\tfunction parseJsonValue_(value) {\n217\t  if (value === '' || value === null || typeof value === 'undefined') {\n218\t    return null;\n219\t  }\n220\t  if (typeof value !== 'string') {\n221\t    return value;\n222\t  }\n223\t  try {\n224\t    return JSON.parse(value);\n225\t  } catch (e) {\n226\t    return value;\n227\t  }\n228\t}\n229\t\n230\tfunction appendRow_(sheet, headers, row) {\n231\t  var values = headers.map(function (header) {\n232\t    return row[header];\n233\t  });\n234\t  sheet.getRange(sheet.getLastRow() + 1, 1, 1, values.length).setValues([values]);\n235\t}\n236\t\n237\tfunction writeRow_(sheet, rowNumber, headers, row) {\n238\t  var values = headers.map(function (header) {\n239\t    return row[header];\n240\t  });\n241\t  sheet.getRange(rowNumber, 1, 1, values.length).setValues([values]);\n242\t}\n243\t\n244\tfunction mergeRow_(headers, current, patch) {\n245\t  var merged = copyObject_(current);\n246\t  headers.forEach(function (header) {\n247\t    if (Object.prototype.hasOwnProperty.call(patch, header)) {\n248\t      merged[header] = patch[header];\n249\t    }\n250\t  });\n251\t  return merged;\n252\t}\n253\t\n254\tfunction copyObject_(obj) {\n255\t  return JSON.parse(JSON.stringify(obj || {}));\n256\t}\n257\t"}]},"parent_tool_use_id":null,"session_id":"5d2c37ab-37fd-43d1-b0c8-73f1bae6b85d","uuid":"1e66f777-1ed1-4410-8809-57d94c560b53","timestamp":"2026-07-21T22:24:07.854Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/core/db.gs","content":"/**\n * INF-002 — Generic read/write data layer with a single locked write path.\n * All table mutation goes through the helpers below to preserve atomic\n * sequence increments and Activity logging.\n */\n\nvar PANEL_OPS_ID_PREFIXES = {\n  Customers: 'CUS',\n  Tickets: 'ORD',\n  Parts: 'PRT',\n  Quotations: 'QTN',\n  Quotation_Lines: 'QTL',\n  Payments: 'PAY',\n  Panel_Prices: 'PPR',\n  Cut_Prices: 'CPR',\n  Edge_Banding_Prices: 'EPR',\n  Users: 'USR',\n  Workflow_States: 'WFS',\n  Activity: 'ACT',\n  Documents: 'DOC',\n  Configuration: 'CFG',\n  Loss_Reasons: 'LRS',\n  Imports: 'IMP'\n};\n\nvar db = {\n  read: function (tableName, filterFn) {\n    var table = getTableSpec_(tableName);\n    var sheet = getSheet_(tableName);\n    var rows = sheet.getDataRange().getValues();\n    if (rows.length <= 1) {\n      return [];\n    }\n\n    var headers = rows[0];\n    var results = [];\n    for (var i = 1; i < rows.length; i++) {\n      var rowObject = rowToObject_(headers, rows[i]);\n      if (!filterFn || filterFn(rowObject)) {\n        results.push(rowObject);\n      }\n    }\n    return results;\n  },\n\n  insert: function (tableName, row, meta) {\n    return withPanelOpsLock_(function () {\n      var table = getTableSpec_(tableName);\n      var sheet = getSheet_(tableName);\n      var record = normalizeRowForInsert_(tableName, row);\n      ensureSequenceId_(tableName, record);\n      appendRow_(sheet, table.headers, record);\n      activityLog_('insert', tableName, record, null, null, meta);\n      return record;\n    });\n  },\n\n  update: function (tableName, matchFn, patch, meta) {\n    return withPanelOpsLock_(function () {\n      var table = getTableSpec_(tableName);\n      var sheet = getSheet_(tableName);\n      var data = sheet.getDataRange().getValues();\n      if (data.length <= 1) {\n        return null;\n      }\n\n      var headers = data[0];\n      for (var i = 1; i < data.length; i++) {\n        var current = rowToObject_(headers, data[i]);\n        if (!matchFn(current)) {\n          continue;\n        }\n        var before = copyObject_(current);\n        var updated = mergeRow_(table.headers, current, patch);\n        writeRow_(sheet, i + 1, table.headers, updated);\n        activityLog_('update', tableName, updated, before, patch, meta);\n        return updated;\n      }\n      return null;\n    });\n  }\n};\n\nfunction getTableSpec_(tableName) {\n  for (var i = 0; i < PANEL_OPS_SCHEMA.length; i++) {\n    if (PANEL_OPS_SCHEMA[i].name === tableName) {\n      return PANEL_OPS_SCHEMA[i];\n    }\n  }\n  throw new Error('Unknown table: ' + tableName);\n}\n\nfunction getSheet_(tableName) {\n  var ss = getPanelOpsSpreadsheet_();\n  var sheet = ss.getSheetByName(tableName);\n  if (!sheet) {\n    throw new Error('Missing sheet: ' + tableName);\n  }\n  return sheet;\n}\n\nfunction getPanelOpsSpreadsheet_() {\n  var props = PropertiesService.getScriptProperties();\n  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n  if (!id) {\n    throw new Error('Missing spreadsheet id property: ' + PANEL_OPS_SS_ID_PROP);\n  }\n  return SpreadsheetApp.openById(id);\n}\n\nfunction withPanelOpsLock_(callback) {\n  var lock = LockService.getScriptLock();\n  lock.waitLock(30000);\n  try {\n    return callback();\n  } finally {\n    lock.releaseLock();\n  }\n}\n\nfunction rowToObject_(headers, values) {\n  var out = {};\n  for (var i = 0; i < headers.length; i++) {\n    out[headers[i]] = values[i];\n  }\n  return out;\n}\n\nfunction normalizeRowForInsert_(tableName, row) {\n  var table = getTableSpec_(tableName);\n  var normalized = {};\n  table.headers.forEach(function (header) {\n    if (Object.prototype.hasOwnProperty.call(row, header)) {\n      normalized[header] = row[header];\n    } else {\n      normalized[header] = '';\n    }\n  });\n  return normalized;\n}\n\nfunction ensureSequenceId_(tableName, row) {\n  var idField = getTableSpec_(tableName).headers[0];\n  if (row[idField]) {\n    return row;\n  }\n\n  if (tableName === 'Tickets') {\n    row[idField] = nextTicketId_();\n    return row;\n  }\n\n  row[idField] = nextPrefixedId_(tableName);\n  return row;\n}\n\nfunction nextPrefixedId_(tableName) {\n  var seqKey = getSequenceKeyForTable_(tableName);\n  var sequences = getSequenceState_();\n  sequences[seqKey] = Number(sequences[seqKey] || 0) + 1;\n  persistSequenceState_(sequences);\n  return PANEL_OPS_ID_PREFIXES[tableName] + '-' + padNumber_(sequences[seqKey], 4);\n}\n\nfunction nextTicketId_() {\n  var sequences = getSequenceState_();\n  var stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMM');\n  if (!sequences.ticket_monthly) {\n    sequences.ticket_monthly = {};\n  }\n  sequences.ticket_monthly[stamp] = Number(sequences.ticket_monthly[stamp] || 0) + 1;\n  persistSequenceState_(sequences);\n  return 'ORD-' + stamp + '-' + padNumber_(sequences.ticket_monthly[stamp], 4);\n}\n\nfunction getSequenceKeyForTable_(tableName) {\n  return String(tableName).replace(/[^A-Za-z0-9]/g, '_').toLowerCase();\n}\n\nfunction getSequenceState_() {\n  var config = getConfigurationMap_();\n  var stored = config.sequences;\n  if (stored && typeof stored === 'object') {\n    return copyObject_(stored);\n  }\n  return copyObject_(SEQUENCES_SEED);\n}\n\nfunction persistSequenceState_(sequences) {\n  upsertConfigurationValue_('sequences', sequences, 'Contadores de secuencia por tipo de ID');\n}\n\nfunction getConfigurationMap_() {\n  var rows = db.read('Configuration');\n  var map = {};\n  rows.forEach(function (row) {\n    map[row.key] = parseJsonValue_(row.value_json);\n  });\n  return map;\n}\n\nfunction upsertConfigurationValue_(key, value, description) {\n  var sheet = getSheet_('Configuration');\n  var data = sheet.getDataRange().getValues();\n  var now = new Date().toISOString();\n  var serialized = JSON.stringify(value);\n  for (var i = 1; i < data.length; i++) {\n    if (data[i][0] === key) {\n      sheet.getRange(i + 1, 2, 1, 4).setValues([[serialized, description || data[i][2], 'setupPanelOpsWorkbook', now]]);\n      return;\n    }\n  }\n  sheet.getRange(sheet.getLastRow() + 1, 1, 1, 5).setValues([[key, serialized, description || '', 'setupPanelOpsWorkbook', now]]);\n}\n\nfunction parseJsonValue_(value) {\n  if (value === '' || value === null || typeof value === 'undefined') {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction appendRow_(sheet, headers, row) {\n  var values = headers.map(function (header) {\n    return row[header];\n  });\n  sheet.getRange(sheet.getLastRow() + 1, 1, 1, values.length).setValues([values]);\n}\n\nfunction writeRow_(sheet, rowNumber, headers, row) {\n  var values = headers.map(function (header) {\n    return row[header];\n  });\n  sheet.getRange(rowNumber, 1, 1, values.length).setValues([values]);\n}\n\nfunction mergeRow_(headers, current, patch) {\n  var merged = copyObject_(current);\n  headers.forEach(function (header) {\n    if (Object.prototype.hasOwnProperty.call(patch, header)) {\n      merged[header] = patch[header];\n    }\n  });\n  return merged;\n}\n\nfunction copyObject_(obj) {\n  return JSON.parse(JSON.stringify(obj || {}));\n}\n","numLines":257,"startLine":1,"totalLines":257}}}
