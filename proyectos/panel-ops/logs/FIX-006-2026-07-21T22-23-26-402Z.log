{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019y81cMz1m8JmbH6p1BTmBG","type":"tool_result","content":"1\t/**\n2\t * INF-001 — Self-check: reads back every tab/header from the live workbook\n3\t * and diffs against PANEL_OPS_SCHEMA, logging PASS/FAIL per tab. Also\n4\t * checks seed presence (Workflow_States=17 rows, all Configuration seed\n5\t * keys present, Loss_Reasons non-empty, Users>=3 rows). Run after\n6\t * setupPanelOpsWorkbook(); safe to run any number of times (read-only).\n7\t */\n8\t\n9\tfunction runSelfCheck() {\n10\t  var props = PropertiesService.getScriptProperties();\n11\t  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n12\t  if (!id) {\n13\t    Logger.log('FAIL — no ' + PANEL_OPS_SS_ID_PROP + ' script property found. Run setupPanelOpsWorkbook() first.');\n14\t    return { allPass: false, results: [] };\n15\t  }\n16\t  var ss = SpreadsheetApp.openById(id);\n17\t  var results = [];\n18\t\n19\t  PANEL_OPS_SCHEMA.forEach(function (table) {\n20\t    results.push(checkTabHeaders_(ss, table));\n21\t  });\n22\t  results.push(checkWorkflowStatesSeed_(ss));\n23\t  results.push(checkConfigurationSeed_(ss));\n24\t  results.push(checkLossReasonsSeed_(ss));\n25\t  results.push(checkUsersSeed_(ss));\n26\t\n27\t  var allPass = results.every(function (r) { return r.pass; });\n28\t  results.forEach(function (r) {\n29\t    Logger.log((r.pass ? 'PASS' : 'FAIL') + ' — ' + r.name + (r.detail ? ' — ' + r.detail : ''));\n30\t  });\n31\t  Logger.log('runSelfCheck ' + (allPass ? 'ALL PASS' : 'FAILURES PRESENT') +\n32\t    ' (' + results.length + ' checks, spreadsheet ' + ss.getUrl() + ')');\n33\t  return { allPass: allPass, results: results };\n34\t}\n35\t\n36\tfunction checkTabHeaders_(ss, table) {\n37\t  var sheet = ss.getSheetByName(table.name);\n38\t  if (!sheet) {\n39\t    return { name: table.name, pass: false, detail: 'tab missing' };\n40\t  }\n41\t  var current = sheet.getRange(1, 1, 1, table.headers.length).getValues()[0];\n42\t  var mismatches = [];\n43\t  table.headers.forEach(function (h, i) {\n44\t    if (current[i] !== h) {\n45\t      mismatches.push('col ' + (i + 1) + ' expected \"' + h + '\" got \"' + current[i] + '\"');\n46\t    }\n47\t  });\n48\t  if (mismatches.length > 0) {\n49\t    return { name: table.name, pass: false, detail: mismatches.join('; ') };\n50\t  }\n51\t  return { name: table.name, pass: true };\n52\t}\n53\t\n54\tfunction checkWorkflowStatesSeed_(ss) {\n55\t  var sheet = ss.getSheetByName('Workflow_States');\n56\t  var rows = sheet.getLastRow() - 1;\n57\t  var expected = WORKFLOW_STATES_SEED.length;\n58\t  return {\n59\t    name: 'Workflow_States seed',\n60\t    pass: rows === expected,\n61\t    detail: rows + '/' + expected + ' rows'\n62\t  };\n63\t}\n64\t\n65\tfunction checkConfigurationSeed_(ss) {\n66\t  var sheet = ss.getSheetByName('Configuration');\n67\t  var lastRow = sheet.getLastRow();\n68\t  var existingKeys = {};\n69\t  if (lastRow > 1) {\n70\t    sheet.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (row) {\n71\t      existingKeys[row[0]] = true;\n72\t    });\n73\t  }\n74\t  var missing = CONFIGURATION_SEED\n75\t    .map(function (entry) { return entry[0]; })\n76\t    .filter(function (key) { return !existingKeys[key]; });\n77\t  return {\n78\t    name: 'Configuration seed keys',\n79\t    pass: missing.length === 0,\n80\t    detail: missing.length === 0 ? 'all present' : 'missing: ' + missing.join(', ')\n81\t  };\n82\t}\n83\t\n84\tfunction checkLossReasonsSeed_(ss) {\n85\t  var sheet = ss.getSheetByName('Loss_Reasons');\n86\t  var rows = sheet.getLastRow() - 1;\n87\t  return { name: 'Loss_Reasons seed', pass: rows >= LOSS_REASONS_SEED.length, detail: rows + ' rows' };\n88\t}\n89\t\n90\tfunction checkUsersSeed_(ss) {\n91\t  var sheet = ss.getSheetByName('Users');\n92\t  var rows = sheet.getLastRow() - 1;\n93\t  return { name: 'Users seed', pass: rows >= 3, detail: rows + ' rows' };\n94\t}\n95\t"}]},"parent_tool_use_id":null,"session_id":"5d2c37ab-37fd-43d1-b0c8-73f1bae6b85d","uuid":"663b6768-1c00-40ce-82ed-bda91e846533","timestamp":"2026-07-21T22:24:05.148Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/setup/selfCheck.gs","content":"/**\n * INF-001 — Self-check: reads back every tab/header from the live workbook\n * and diffs against PANEL_OPS_SCHEMA, logging PASS/FAIL per tab. Also\n * checks seed presence (Workflow_States=17 rows, all Configuration seed\n * keys present, Loss_Reasons non-empty, Users>=3 rows). Run after\n * setupPanelOpsWorkbook(); safe to run any number of times (read-only).\n */\n\nfunction runSelfCheck() {\n  var props = PropertiesService.getScriptProperties();\n  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n  if (!id) {\n    Logger.log('FAIL — no ' + PANEL_OPS_SS_ID_PROP + ' script property found. Run setupPanelOpsWorkbook() first.');\n    return { allPass: false, results: [] };\n  }\n  var ss = SpreadsheetApp.openById(id);\n  var results = [];\n\n  PANEL_OPS_SCHEMA.forEach(function (table) {\n    results.push(checkTabHeaders_(ss, table));\n  });\n  results.push(checkWorkflowStatesSeed_(ss));\n  results.push(checkConfigurationSeed_(ss));\n  results.push(checkLossReasonsSeed_(ss));\n  results.push(checkUsersSeed_(ss));\n\n  var allPass = results.every(function (r) { return r.pass; });\n  results.forEach(function (r) {\n    Logger.log((r.pass ? 'PASS' : 'FAIL') + ' — ' + r.name + (r.detail ? ' — ' + r.detail : ''));\n  });\n  Logger.log('runSelfCheck ' + (allPass ? 'ALL PASS' : 'FAILURES PRESENT') +\n    ' (' + results.length + ' checks, spreadsheet ' + ss.getUrl() + ')');\n  return { allPass: allPass, results: results };\n}\n\nfunction checkTabHeaders_(ss, table) {\n  var sheet = ss.getSheetByName(table.name);\n  if (!sheet) {\n    return { name: table.name, pass: false, detail: 'tab missing' };\n  }\n  var current = sheet.getRange(1, 1, 1, table.headers.length).getValues()[0];\n  var mismatches = [];\n  table.headers.forEach(function (h, i) {\n    if (current[i] !== h) {\n      mismatches.push('col ' + (i + 1) + ' expected \"' + h + '\" got \"' + current[i] + '\"');\n    }\n  });\n  if (mismatches.length > 0) {\n    return { name: table.name, pass: false, detail: mismatches.join('; ') };\n  }\n  return { name: table.name, pass: true };\n}\n\nfunction checkWorkflowStatesSeed_(ss) {\n  var sheet = ss.getSheetByName('Workflow_States');\n  var rows = sheet.getLastRow() - 1;\n  var expected = WORKFLOW_STATES_SEED.length;\n  return {\n    name: 'Workflow_States seed',\n    pass: rows === expected,\n    detail: rows + '/' + expected + ' rows'\n  };\n}\n\nfunction checkConfigurationSeed_(ss) {\n  var sheet = ss.getSheetByName('Configuration');\n  var lastRow = sheet.getLastRow();\n  var existingKeys = {};\n  if (lastRow > 1) {\n    sheet.getRange(2, 1, lastRow - 1, 1).getValues().forEach(function (row) {\n      existingKeys[row[0]] = true;\n    });\n  }\n  var missing = CONFIGURATION_SEED\n    .map(function (entry) { return entry[0]; })\n    .filter(function (key) { return !existingKeys[key]; });\n  return {\n    name: 'Configuration seed keys',\n    pass: missing.length === 0,\n    detail: missing.length === 0 ? 'all present' : 'missing: ' + missing.join(', ')\n  };\n}\n\nfunction checkLossReasonsSeed_(ss) {\n  var sheet = ss.getSheetByName('Loss_Reasons');\n  var rows = sheet.getLastRow() - 1;\n  return { name: 'Loss_Reasons seed', pass: rows >= LOSS_REASONS_SEED.length, detail: rows + ' rows' };\n}\n\nfunction checkUsersSeed_(ss) {\n  var sheet = ss.getSheetByName('Users');\n  var rows = sheet.getLastRow() - 1;\n  return { name: 'Users seed', pass: rows >= 3, detail: rows + ' rows' };\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
