{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013RENEup2zarJ3dFB9W4gEh","type":"tool_result","content":"1\t/**\n2\t * INF-001 — Idempotent Panel-Ops workbook bootstrap.\n3\t * Entry point: run setupPanelOpsWorkbook() once from the Apps Script editor\n4\t * (or any trigger) bound to this project. Safe to re-run: it will not\n5\t * duplicate the workbook, tabs, header rows, or seed rows.\n6\t */\n7\t\n8\tvar PANEL_OPS_SS_ID_PROP = 'PANEL_OPS_SPREADSHEET_ID';\n9\tvar PANEL_OPS_WORKBOOK_NAME = 'Panel-Ops';\n10\t\n11\tfunction setupPanelOpsWorkbook() {\n12\t  var ss = getOrCreatePanelOpsWorkbook_();\n13\t  ensureAllTabs_(ss);\n14\t  seedWorkflowStatesIfEmpty_(ss);\n15\t  seedConfigurationKeys_(ss);\n16\t  seedLossReasonsIfEmpty_(ss);\n17\t  seedUsersIfEmpty_(ss);\n18\t  removeUnmanagedDefaultSheet_(ss);\n19\t  Logger.log('setupPanelOpsWorkbook complete. Spreadsheet: ' + ss.getUrl());\n20\t  return ss.getUrl();\n21\t}\n22\t\n23\tfunction getOrCreatePanelOpsWorkbook_() {\n24\t  var props = PropertiesService.getScriptProperties();\n25\t  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n26\t  if (id) {\n27\t    try {\n28\t      return SpreadsheetApp.openById(id);\n29\t    } catch (e) {\n30\t      Logger.log('Stored spreadsheet id ' + id + ' is no longer accessible, creating a new workbook. ' + e);\n31\t    }\n32\t  }\n33\t  var ss = SpreadsheetApp.create(PANEL_OPS_WORKBOOK_NAME);\n34\t  props.setProperty(PANEL_OPS_SS_ID_PROP, ss.getId());\n35\t  return ss;\n36\t}\n37\t\n38\tfunction ensureAllTabs_(ss) {\n39\t  PANEL_OPS_SCHEMA.forEach(function (table) {\n40\t    var sheet = ss.getSheetByName(table.name);\n41\t    if (!sheet) {\n42\t      sheet = ss.insertSheet(table.name);\n43\t    }\n44\t    writeHeaderIfNeeded_(sheet, table.headers);\n45\t  });\n46\t}\n47\t\n48\tfunction writeHeaderIfNeeded_(sheet, headers) {\n49\t  var range = sheet.getRange(1, 1, 1, headers.length);\n50\t  var current = range.getValues()[0];\n51\t  var matches = headers.every(function (h, i) { return current[i] === h; });\n52\t  if (!matches) {\n53\t    range.setValues([headers]);\n54\t  }\n55\t  if (sheet.getFrozenRows() < 1) {\n56\t    sheet.setFrozenRows(1);\n57\t  }\n58\t}\n59\t\n60\tfunction seedWorkflowStatesIfEmpty_(ss) {\n61\t  var sheet = ss.getSheetByName('Workflow_States');\n62\t  if (sheet.getLastRow() > 1) {\n63\t    return; // already seeded\n64\t  }\n65\t  sheet.getRange(2, 1, WORKFLOW_STATES_SEED.length, WORKFLOW_STATES_SEED[0].length)\n66\t    .setValues(WORKFLOW_STATES_SEED);\n67\t}\n68\t\n69\tfunction seedConfigurationKeys_(ss) {\n70\t  var sheet = ss.getSheetByName('Configuration');\n71\t  var lastRow = sheet.getLastRow();\n72\t  var existingKeys = {};\n73\t  if (lastRow > 1) {\n74\t    var keyColumn = sheet.getRange(2, 1, lastRow - 1, 1).getValues();\n75\t    keyColumn.forEach(function (row) { existingKeys[row[0]] = true; });\n76\t  }\n77\t  var now = new Date().toISOString();\n78\t  var rowsToAppend = [];\n79\t  CONFIGURATION_SEED.forEach(function (entry) {\n80\t    var key = entry[0];\n81\t    if (existingKeys[key]) {\n82\t      return; // never overwrite an existing key (may have been edited by a user)\n83\t    }\n84\t    rowsToAppend.push([key, JSON.stringify(entry[1]), entry[2], 'setupPanelOpsWorkbook', now]);\n85\t  });\n86\t  if (rowsToAppend.length > 0) {\n87\t    sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, 5).setValues(rowsToAppend);\n88\t  }\n89\t}\n90\t\n91\tfunction seedLossReasonsIfEmpty_(ss) {\n92\t  var sheet = ss.getSheetByName('Loss_Reasons');\n93\t  if (sheet.getLastRow() > 1) {\n94\t    return;\n95\t  }\n96\t  sheet.getRange(2, 1, LOSS_REASONS_SEED.length, LOSS_REASONS_SEED[0].length)\n97\t    .setValues(LOSS_REASONS_SEED);\n98\t}\n99\t\n100\tfunction seedUsersIfEmpty_(ss) {\n101\t  var sheet = ss.getSheetByName('Users');\n102\t  if (sheet.getLastRow() > 1) {\n103\t    return;\n104\t  }\n105\t  var now = new Date().toISOString();\n106\t  var rows = USERS_SEED.map(function (u) { return u.concat([now]); });\n107\t  sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);\n108\t}\n109\t\n110\tfunction removeUnmanagedDefaultSheet_(ss) {\n111\t  var defaultSheet = ss.getSheetByName('Sheet1');\n112\t  if (defaultSheet && ss.getSheets().length > 1) {\n113\t    var isEmpty = defaultSheet.getLastRow() === 0 && defaultSheet.getLastColumn() === 0;\n114\t    if (isEmpty) {\n115\t      ss.deleteSheet(defaultSheet);\n116\t    }\n117\t  }\n118\t}\n119\t"}]},"parent_tool_use_id":null,"session_id":"0d24f395-8d4d-4147-9711-46f561b0a2bc","uuid":"0df1a656-70a9-465a-a5f4-3faaaa08cc7d","timestamp":"2026-07-18T03:43:32.561Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/setup/setup.gs","content":"/**\n * INF-001 — Idempotent Panel-Ops workbook bootstrap.\n * Entry point: run setupPanelOpsWorkbook() once from the Apps Script editor\n * (or any trigger) bound to this project. Safe to re-run: it will not\n * duplicate the workbook, tabs, header rows, or seed rows.\n */\n\nvar PANEL_OPS_SS_ID_PROP = 'PANEL_OPS_SPREADSHEET_ID';\nvar PANEL_OPS_WORKBOOK_NAME = 'Panel-Ops';\n\nfunction setupPanelOpsWorkbook() {\n  var ss = getOrCreatePanelOpsWorkbook_();\n  ensureAllTabs_(ss);\n  seedWorkflowStatesIfEmpty_(ss);\n  seedConfigurationKeys_(ss);\n  seedLossReasonsIfEmpty_(ss);\n  seedUsersIfEmpty_(ss);\n  removeUnmanagedDefaultSheet_(ss);\n  Logger.log('setupPanelOpsWorkbook complete. Spreadsheet: ' + ss.getUrl());\n  return ss.getUrl();\n}\n\nfunction getOrCreatePanelOpsWorkbook_() {\n  var props = PropertiesService.getScriptProperties();\n  var id = props.getProperty(PANEL_OPS_SS_ID_PROP);\n  if (id) {\n    try {\n      return SpreadsheetApp.openById(id);\n    } catch (e) {\n      Logger.log('Stored spreadsheet id ' + id + ' is no longer accessible, creating a new workbook. ' + e);\n    }\n  }\n  var ss = SpreadsheetApp.create(PANEL_OPS_WORKBOOK_NAME);\n  props.setProperty(PANEL_OPS_SS_ID_PROP, ss.getId());\n  return ss;\n}\n\nfunction ensureAllTabs_(ss) {\n  PANEL_OPS_SCHEMA.forEach(function (table) {\n    var sheet = ss.getSheetByName(table.name);\n    if (!sheet) {\n      sheet = ss.insertSheet(table.name);\n    }\n    writeHeaderIfNeeded_(sheet, table.headers);\n  });\n}\n\nfunction writeHeaderIfNeeded_(sheet, headers) {\n  var range = sheet.getRange(1, 1, 1, headers.length);\n  var current = range.getValues()[0];\n  var matches = headers.every(function (h, i) { return current[i] === h; });\n  if (!matches) {\n    range.setValues([headers]);\n  }\n  if (sheet.getFrozenRows() < 1) {\n    sheet.setFrozenRows(1);\n  }\n}\n\nfunction seedWorkflowStatesIfEmpty_(ss) {\n  var sheet = ss.getSheetByName('Workflow_States');\n  if (sheet.getLastRow() > 1) {\n    return; // already seeded\n  }\n  sheet.getRange(2, 1, WORKFLOW_STATES_SEED.length, WORKFLOW_STATES_SEED[0].length)\n    .setValues(WORKFLOW_STATES_SEED);\n}\n\nfunction seedConfigurationKeys_(ss) {\n  var sheet = ss.getSheetByName('Configuration');\n  var lastRow = sheet.getLastRow();\n  var existingKeys = {};\n  if (lastRow > 1) {\n    var keyColumn = sheet.getRange(2, 1, lastRow - 1, 1).getValues();\n    keyColumn.forEach(function (row) { existingKeys[row[0]] = true; });\n  }\n  var now = new Date().toISOString();\n  var rowsToAppend = [];\n  CONFIGURATION_SEED.forEach(function (entry) {\n    var key = entry[0];\n    if (existingKeys[key]) {\n      return; // never overwrite an existing key (may have been edited by a user)\n    }\n    rowsToAppend.push([key, JSON.stringify(entry[1]), entry[2], 'setupPanelOpsWorkbook', now]);\n  });\n  if (rowsToAppend.length > 0) {\n    sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, 5).setValues(rowsToAppend);\n  }\n}\n\nfunction seedLossReasonsIfEmpty_(ss) {\n  var sheet = ss.getSheetByName('Loss_Reasons');\n  if (sheet.getLastRow() > 1) {\n    return;\n  }\n  sheet.getRange(2, 1, LOSS_REASONS_SEED.length, LOSS_REASONS_SEED[0].length)\n    .setValues(LOSS_REASONS_SEED);\n}\n\nfunction seedUsersIfEmpty_(ss) {\n  var sheet = ss.getSheetByName('Users');\n  if (sheet.getLastRow() > 1) {\n    return;\n  }\n  var now = new Date().toISOString();\n  var rows = USERS_SEED.map(function (u) { return u.concat([now]); });\n  sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);\n}\n\nfunction removeUnmanagedDefaultSheet_(ss) {\n  var defaultSheet = ss.getSheetByName('Sheet1');\n  if (defaultSheet && ss.getSheets().length > 1) {\n    var isEmpty = defaultSheet.getLastRow() === 0 && defaultSheet.getLastColumn() === 0;\n    if (isEmpty) {\n      ss.deleteSheet(defaultSheet);\n    }\n  }\n}\n","numLines":119,"startLine":1,"totalLines":119}}}
