{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cd8pKXGqfhjJAbJErtzEL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U9CjY5c9uUvKcKsG8C9n8G","name":"Write","input":{"file_path":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/setup/Schema.gs","content":"/**\n * Panel-Ops — Workbook schema constants.\n * Source of truth: data-model.md. Header names and order are normative —\n * do not add, remove, or reorder columns without updating data-model.md first.\n * Reused by INF-001 setup/self-check and by later modules (INF-002+) that\n * need canonical table/column names.\n */\n\n// Order matters only for tab creation order; it has no semantic meaning.\nvar SCHEMA_TAB_ORDER = [\n  'Customers',\n  'Tickets',\n  'Parts',\n  'Quotations',\n  'Quotation_Lines',\n  'Payments',\n  'Panel_Prices',\n  'Cut_Prices',\n  'Edge_Banding_Prices',\n  'Users',\n  'Workflow_States',\n  'Activity',\n  'Documents',\n  'Configuration',\n  'Loss_Reasons',\n  'Imports'\n];\n\nvar SCHEMA_HEADERS = {\n  Customers: [\n    'customer_id', 'legal_name', 'person_type', 'id_type', 'id_number',\n    'phone', 'email', 'contact_name', 'notes', 'created_at', 'updated_at', 'deleted_at'\n  ],\n  Tickets: [\n    'ticket_id', 'created_at', 'intake_channel', 'advisor_email', 'customer_id',\n    'workflow_state', 'labels', 'priority', 'internal_deadline', 'last_activity_at',\n    'next_action', 'next_action_owner', 'waiting_on', 'quoted_value', 'approved_value',\n    'paid_value', 'payment_method', 'payment_state', 'payment_confirmed_at',\n    'loss_reason', 'notes', 'drive_folder_url', 'original_request_url',\n    'quotation_pdf_url', 'production_file_url', 'cutting_plan_url',\n    'payment_evidence_url', 'delivery_evidence_url', 'closed_at', 'deleted_at'\n  ],\n  Parts: [\n    'part_id', 'ticket_id', 'customer_part_number', 'qty', 'length_mm', 'width_mm',\n    'material', 'panel_ref', 'thickness_mm', 'grain_required', 'edge_top',\n    'edge_bottom', 'edge_left', 'edge_right', 'tape_type', 'tape_thickness',\n    'notes', 'source', 'customer_confirmed', 'advisor_validated',\n    'validation_warnings', 'created_at', 'updated_at', 'deleted_at'\n  ],\n  Quotations: [\n    'quotation_id', 'ticket_id', 'version', 'status', 'sent_at', 'valid_until',\n    'decision', 'decision_at', 'decision_evidence_doc', 'subtotal', 'vat_rate',\n    'vat_amount', 'withholding_json', 'total', 'price_snapshot_json', 'immutable',\n    'pdf_doc', 'created_by', 'created_at'\n  ],\n  Quotation_Lines: [\n    'line_id', 'quotation_id', 'line_type', 'description', 'qty', 'unit',\n    'unit_price', 'line_total', 'source_price_id', 'meta_json'\n  ],\n  Payments: [\n    'payment_id', 'ticket_id', 'quotation_id', 'method', 'amount', 'currency',\n    'registered_by', 'registered_at', 'verified_by', 'verified_at', 'status',\n    'evidence_doc', 'notes'\n  ],\n  Panel_Prices: [\n    'price_id', 'effective_from', 'updated_by', 'active', 'notes',\n    'supplier', 'material', 'panel_ref', 'panel_length_mm', 'panel_width_mm',\n    'thickness_mm', 'price_before_vat', 'price_with_vat'\n  ],\n  Cut_Prices: [\n    'price_id', 'effective_from', 'updated_by', 'active', 'notes',\n    'thickness_mm', 'price_per_cut', 'customer_supplied_surcharge_pct_or_amount'\n  ],\n  Edge_Banding_Prices: [\n    'price_id', 'effective_from', 'updated_by', 'active', 'notes',\n    'tape_type', 'tape_thickness', 'tape_price_per_m', 'application_price_per_m'\n  ],\n  Users: [\n    'email', 'full_name', 'role', 'active', 'created_at'\n  ],\n  Workflow_States: [\n    'state_id', 'name_en', 'name_es', 'order', 'category', 'is_terminal', 'aging_critical'\n  ],\n  Activity: [\n    'activity_id', 'ticket_id', 'at', 'actor', 'type', 'from_state', 'to_state',\n    'message', 'meta_json'\n  ],\n  Documents: [\n    'doc_id', 'ticket_id', 'customer_id', 'category', 'filename', 'drive_file_id',\n    'drive_url', 'immutable', 'uploaded_by', 'uploaded_at'\n  ],\n  Configuration: [\n    'key', 'value_json', 'description', 'updated_by', 'updated_at'\n  ],\n  Loss_Reasons: [\n    'reason_id', 'label_es', 'active'\n  ],\n  Imports: [\n    'import_id', 'ticket_id', 'source_doc', 'mapping_json', 'rows_total',\n    'rows_ok', 'rows_failed', 'errors_json', 'imported_by', 'imported_at', 'status'\n  ]\n};\n\n/** Primary key column per tab — used by setup/self-check to detect existing rows for idempotent seeding. */\nvar SCHEMA_PRIMARY_KEY = {\n  Customers: 'customer_id',\n  Tickets: 'ticket_id',\n  Parts: 'part_id',\n  Quotations: 'quotation_id',\n  Quotation_Lines: 'line_id',\n  Payments: 'payment_id',\n  Panel_Prices: 'price_id',\n  Cut_Prices: 'price_id',\n  Edge_Banding_Prices: 'price_id',\n  Users: 'email',\n  Workflow_States: 'state_id',\n  Activity: 'activity_id',\n  Documents: 'doc_id',\n  Configuration: 'key',\n  Loss_Reasons: 'reason_id',\n  Imports: 'import_id'\n};\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":197,"cache_read_input_tokens":66949,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":197},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1e5917af-c357-4825-9d94-3224a238a5cc","uuid":"a26034e3-e316-499d-976e-8ba54226d41a"}
