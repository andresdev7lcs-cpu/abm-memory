{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0119ttZxVwpxUK7onVdcEJJy","type":"tool_result","content":"1\t/**\n2\t * APP-001 — Customers module.\n3\t * Business rules (required fields, duplicate detection, soft delete) layered on\n4\t * top of the generic db/session helpers from INF-002. Entry points below have no\n5\t * trailing underscore so they are callable directly (e.g. via google.script.run);\n6\t * internal helpers keep the project's `_` suffix convention.\n7\t */\n8\t\n9\tvar CUSTOMERS_TABLE = 'Customers';\n10\tvar CUSTOMERS_REQUIRED_FIELDS = ['legal_name', 'person_type', 'id_type', 'id_number', 'phone', 'email', 'contact_name'];\n11\tvar CUSTOMERS_PERSON_TYPES = ['individual', 'legal_entity'];\n12\tvar CUSTOMERS_ID_TYPES = ['CC', 'NIT', 'CE', 'PASSPORT'];\n13\tvar CUSTOMERS_SEARCH_FIELDS = ['legal_name', 'id_number', 'phone', 'email', 'contact_name'];\n14\t\n15\tfunction customersCreate(payload) {\n16\t  var session = getSession();\n17\t  var access = requireRole_(session, ['management', 'sales']);\n18\t  if (!access.ok) {\n19\t    return access;\n20\t  }\n21\t\n22\t  var record = copyObject_(payload || {});\n23\t  var errors = validateCustomerRecord_(record);\n24\t  if (errors.length) {\n25\t    return { ok: false, status: 400, error: 'Datos de cliente inválidos', fields: errors };\n26\t  }\n27\t\n28\t  var now = new Date().toISOString();\n29\t  record.created_at = record.created_at || now;\n30\t  record.updated_at = now;\n31\t  record.deleted_at = '';\n32\t\n33\t  var duplicates = findDuplicateCustomers_(record.id_type, record.id_number, null);\n34\t  var inserted = db.insert(CUSTOMERS_TABLE, record, { actor: session.email, note: 'customers.create' });\n35\t\n36\t  return { ok: true, row: inserted, duplicateWarning: duplicates.length > 0, duplicates: duplicates };\n37\t}\n38\t\n39\tfunction customersUpdate(customerId, patch) {\n40\t  var session = getSession();\n41\t  var access = requireRole_(session, ['management', 'sales']);\n42\t  if (!access.ok) {\n43\t    return access;\n44\t  }\n45\t  if (!customerId) {\n46\t    return { ok: false, status: 400, error: 'customer_id requerido' };\n47\t  }\n48\t\n49\t  var current = findCustomerById_(customerId);\n50\t  if (!current) {\n51\t    return { ok: false, status: 404, error: 'Cliente no encontrado' };\n52\t  }\n53\t\n54\t  var merged = copyObject_(current);\n55\t  var safePatch = copyObject_(patch || {});\n56\t  Object.keys(safePatch).forEach(function (key) {\n57\t    merged[key] = safePatch[key];\n58\t  });\n59\t\n60\t  var errors = validateCustomerRecord_(merged);\n61\t  if (errors.length) {\n62\t    return { ok: false, status: 400, error: 'Datos de cliente inválidos', fields: errors };\n63\t  }\n64\t\n65\t  safePatch.updated_at = new Date().toISOString();\n66\t  var duplicates = findDuplicateCustomers_(merged.id_type, merged.id_number, customerId);\n67\t\n68\t  var updated = db.update(CUSTOMERS_TABLE, function (row) {\n69\t    return row.customer_id === customerId;\n70\t  }, safePatch, { actor: session.email, note: 'customers.update' });\n71\t\n72\t  return { ok: true, row: updated, duplicateWarning: duplicates.length > 0, duplicates: duplicates };\n73\t}\n74\t\n75\tfunction customersList(filters) {\n76\t  var access = requireRole_(getSession(), ['management', 'sales', 'billing']);\n77\t  if (!access.ok) {\n78\t    return access;\n79\t  }\n80\t  var opts = filters || {};\n81\t  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n82\t    if (!opts.includeDeleted && row.deleted_at) {\n83\t      return false;\n84\t    }\n85\t    if (opts.person_type && row.person_type !== opts.person_type) {\n86\t      return false;\n87\t    }\n88\t    return true;\n89\t  });\n90\t  return { ok: true, rows: rows };\n91\t}\n92\t\n93\tfunction customersSearch(query) {\n94\t  var access = requireRole_(getSession(), ['management', 'sales', 'billing']);\n95\t  if (!access.ok) {\n96\t    return access;\n97\t  }\n98\t  var needle = String(query || '').trim().toLowerCase();\n99\t  if (!needle) {\n100\t    return { ok: true, rows: [] };\n101\t  }\n102\t  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n103\t    if (row.deleted_at) {\n104\t      return false;\n105\t    }\n106\t    return CUSTOMERS_SEARCH_FIELDS.some(function (field) {\n107\t      return String(row[field] || '').toLowerCase().indexOf(needle) !== -1;\n108\t    });\n109\t  });\n110\t  return { ok: true, rows: rows };\n111\t}\n112\t\n113\tfunction customersDeactivate(customerId, reason) {\n114\t  var session = getSession();\n115\t  var access = requireRole_(session, ['management', 'sales']);\n116\t  if (!access.ok) {\n117\t    return access;\n118\t  }\n119\t  if (!customerId) {\n120\t    return { ok: false, status: 400, error: 'customer_id requerido' };\n121\t  }\n122\t\n123\t  var current = findCustomerById_(customerId);\n124\t  if (!current) {\n125\t    return { ok: false, status: 404, error: 'Cliente no encontrado' };\n126\t  }\n127\t  if (current.deleted_at) {\n128\t    return { ok: false, status: 409, error: 'Cliente ya está desactivado' };\n129\t  }\n130\t\n131\t  var now = new Date().toISOString();\n132\t  var note = 'customers.deactivate' + (reason ? ' - ' + reason : '');\n133\t  var updated = db.update(CUSTOMERS_TABLE, function (row) {\n134\t    return row.customer_id === customerId;\n135\t  }, { deleted_at: now, updated_at: now }, { actor: session.email, note: note });\n136\t\n137\t  return { ok: true, row: updated };\n138\t}\n139\t\n140\tfunction validateCustomerRecord_(record) {\n141\t  var errors = [];\n142\t  CUSTOMERS_REQUIRED_FIELDS.forEach(function (field) {\n143\t    if (!record[field] || String(record[field]).trim() === '') {\n144\t      errors.push(field);\n145\t    }\n146\t  });\n147\t  if (record.person_type && CUSTOMERS_PERSON_TYPES.indexOf(record.person_type) === -1) {\n148\t    errors.push('person_type');\n149\t  }\n150\t  if (record.id_type && CUSTOMERS_ID_TYPES.indexOf(record.id_type) === -1) {\n151\t    errors.push('id_type');\n152\t  }\n153\t  return errors;\n154\t}\n155\t\n156\tfunction findCustomerById_(customerId) {\n157\t  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n158\t    return row.customer_id === customerId;\n159\t  });\n160\t  return rows.length ? rows[0] : null;\n161\t}\n162\t\n163\tfunction findDuplicateCustomers_(idType, idNumber, excludeId) {\n164\t  if (!idType || !idNumber) {\n165\t    return [];\n166\t  }\n167\t  return db.read(CUSTOMERS_TABLE, function (row) {\n168\t    if (row.deleted_at) {\n169\t      return false;\n170\t    }\n171\t    if (excludeId && row.customer_id === excludeId) {\n172\t      return false;\n173\t    }\n174\t    return row.id_type === idType && String(row.id_number) === String(idNumber);\n175\t  });\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"2ba010ed-03ac-469a-a8dc-1e3686220e8a","uuid":"45bfc15d-83bc-4f03-9159-3ffb2868e772","timestamp":"2026-07-22T13:52:59.251Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/modules/customers/customers.gs","content":"/**\n * APP-001 — Customers module.\n * Business rules (required fields, duplicate detection, soft delete) layered on\n * top of the generic db/session helpers from INF-002. Entry points below have no\n * trailing underscore so they are callable directly (e.g. via google.script.run);\n * internal helpers keep the project's `_` suffix convention.\n */\n\nvar CUSTOMERS_TABLE = 'Customers';\nvar CUSTOMERS_REQUIRED_FIELDS = ['legal_name', 'person_type', 'id_type', 'id_number', 'phone', 'email', 'contact_name'];\nvar CUSTOMERS_PERSON_TYPES = ['individual', 'legal_entity'];\nvar CUSTOMERS_ID_TYPES = ['CC', 'NIT', 'CE', 'PASSPORT'];\nvar CUSTOMERS_SEARCH_FIELDS = ['legal_name', 'id_number', 'phone', 'email', 'contact_name'];\n\nfunction customersCreate(payload) {\n  var session = getSession();\n  var access = requireRole_(session, ['management', 'sales']);\n  if (!access.ok) {\n    return access;\n  }\n\n  var record = copyObject_(payload || {});\n  var errors = validateCustomerRecord_(record);\n  if (errors.length) {\n    return { ok: false, status: 400, error: 'Datos de cliente inválidos', fields: errors };\n  }\n\n  var now = new Date().toISOString();\n  record.created_at = record.created_at || now;\n  record.updated_at = now;\n  record.deleted_at = '';\n\n  var duplicates = findDuplicateCustomers_(record.id_type, record.id_number, null);\n  var inserted = db.insert(CUSTOMERS_TABLE, record, { actor: session.email, note: 'customers.create' });\n\n  return { ok: true, row: inserted, duplicateWarning: duplicates.length > 0, duplicates: duplicates };\n}\n\nfunction customersUpdate(customerId, patch) {\n  var session = getSession();\n  var access = requireRole_(session, ['management', 'sales']);\n  if (!access.ok) {\n    return access;\n  }\n  if (!customerId) {\n    return { ok: false, status: 400, error: 'customer_id requerido' };\n  }\n\n  var current = findCustomerById_(customerId);\n  if (!current) {\n    return { ok: false, status: 404, error: 'Cliente no encontrado' };\n  }\n\n  var merged = copyObject_(current);\n  var safePatch = copyObject_(patch || {});\n  Object.keys(safePatch).forEach(function (key) {\n    merged[key] = safePatch[key];\n  });\n\n  var errors = validateCustomerRecord_(merged);\n  if (errors.length) {\n    return { ok: false, status: 400, error: 'Datos de cliente inválidos', fields: errors };\n  }\n\n  safePatch.updated_at = new Date().toISOString();\n  var duplicates = findDuplicateCustomers_(merged.id_type, merged.id_number, customerId);\n\n  var updated = db.update(CUSTOMERS_TABLE, function (row) {\n    return row.customer_id === customerId;\n  }, safePatch, { actor: session.email, note: 'customers.update' });\n\n  return { ok: true, row: updated, duplicateWarning: duplicates.length > 0, duplicates: duplicates };\n}\n\nfunction customersList(filters) {\n  var access = requireRole_(getSession(), ['management', 'sales', 'billing']);\n  if (!access.ok) {\n    return access;\n  }\n  var opts = filters || {};\n  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n    if (!opts.includeDeleted && row.deleted_at) {\n      return false;\n    }\n    if (opts.person_type && row.person_type !== opts.person_type) {\n      return false;\n    }\n    return true;\n  });\n  return { ok: true, rows: rows };\n}\n\nfunction customersSearch(query) {\n  var access = requireRole_(getSession(), ['management', 'sales', 'billing']);\n  if (!access.ok) {\n    return access;\n  }\n  var needle = String(query || '').trim().toLowerCase();\n  if (!needle) {\n    return { ok: true, rows: [] };\n  }\n  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n    if (row.deleted_at) {\n      return false;\n    }\n    return CUSTOMERS_SEARCH_FIELDS.some(function (field) {\n      return String(row[field] || '').toLowerCase().indexOf(needle) !== -1;\n    });\n  });\n  return { ok: true, rows: rows };\n}\n\nfunction customersDeactivate(customerId, reason) {\n  var session = getSession();\n  var access = requireRole_(session, ['management', 'sales']);\n  if (!access.ok) {\n    return access;\n  }\n  if (!customerId) {\n    return { ok: false, status: 400, error: 'customer_id requerido' };\n  }\n\n  var current = findCustomerById_(customerId);\n  if (!current) {\n    return { ok: false, status: 404, error: 'Cliente no encontrado' };\n  }\n  if (current.deleted_at) {\n    return { ok: false, status: 409, error: 'Cliente ya está desactivado' };\n  }\n\n  var now = new Date().toISOString();\n  var note = 'customers.deactivate' + (reason ? ' - ' + reason : '');\n  var updated = db.update(CUSTOMERS_TABLE, function (row) {\n    return row.customer_id === customerId;\n  }, { deleted_at: now, updated_at: now }, { actor: session.email, note: note });\n\n  return { ok: true, row: updated };\n}\n\nfunction validateCustomerRecord_(record) {\n  var errors = [];\n  CUSTOMERS_REQUIRED_FIELDS.forEach(function (field) {\n    if (!record[field] || String(record[field]).trim() === '') {\n      errors.push(field);\n    }\n  });\n  if (record.person_type && CUSTOMERS_PERSON_TYPES.indexOf(record.person_type) === -1) {\n    errors.push('person_type');\n  }\n  if (record.id_type && CUSTOMERS_ID_TYPES.indexOf(record.id_type) === -1) {\n    errors.push('id_type');\n  }\n  return errors;\n}\n\nfunction findCustomerById_(customerId) {\n  var rows = db.read(CUSTOMERS_TABLE, function (row) {\n    return row.customer_id === customerId;\n  });\n  return rows.length ? rows[0] : null;\n}\n\nfunction findDuplicateCustomers_(idType, idNumber, excludeId) {\n  if (!idType || !idNumber) {\n    return [];\n  }\n  return db.read(CUSTOMERS_TABLE, function (row) {\n    if (row.deleted_at) {\n      return false;\n    }\n    if (excludeId && row.customer_id === excludeId) {\n      return false;\n    }\n    return row.id_type === idType && String(row.id_number) === String(idNumber);\n  });\n}\n","numLines":177,"startLine":1,"totalLines":177}}}
