const REFRESH_MS = 4000;
let ticketsCache = [];
let allowlists = { models: [], runners: [] };
// FIX-004: survives poll-triggered re-renders (buildCard destroys/rebuilds
// selects every REFRESH_MS); populated on change, consulted by buildCard().
const userSelections = new Map(); // ticketId -> { runner, model }

function el(tag, attrs = {}, children = []) {
  const node = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (k === 'class') node.className = v;
    else if (k === 'text') node.textContent = v;
    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
    else if (v === null || v === undefined || v === false) continue;
    else node.setAttribute(k, v);
  }
  for (const c of children) node.appendChild(c);
  return node;
}

function showToast(message, isError) {
  const t = document.getElementById('toast');
  t.textContent = message;
  t.className = 'toast open' + (isError ? ' error' : '');
  clearTimeout(showToast._timer);
  showToast._timer = setTimeout(() => { t.className = 'toast'; }, 5000);
}

async function fetchJson(url, opts) {
  const res = await fetch(url, opts);
  let body;
  try { body = await res.json(); } catch { body = null; }
  if (!res.ok) {
    const msg = (body && body.error) ? body.error : `HTTP ${res.status}`;
    const err = new Error(msg);
    err.status = res.status;
    err.body = body;
    throw err;
  }
  return body;
}

async function loadAllowlists() {
  try {
    const data = await fetchJson('/api/allowlists');
    allowlists = data;
  } catch (e) {
    console.error(e);
  }
}

