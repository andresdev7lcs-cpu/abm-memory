}

async function loadTickets() {
  try {
    const data = await fetchJson('/api/tickets');
    ticketsCache = data.tickets;
    render();
    document.getElementById('refresh-meta').textContent =
      'actualizado ' + new Date().toLocaleTimeString() + ' — ' + data.count + ' tickets';
  } catch (e) {
    document.getElementById('refresh-meta').textContent = 'error al refrescar: ' + e.message;
  }
}

function depPill(dep) {
  return el('span', {
    class: 'dep-pill ' + (dep.completed ? 'done' : 'pending'),
    text: dep.id + (dep.completed ? ' ✓' : ' …'),
  });
}

function buildCard(ticket) {
  const card = el('div', { class: 'card', 'data-ticket': ticket.id });

  const idRow = el('div', { class: 'id-row' }, [
    el('span', { class: 'id', text: ticket.id }),
    el('span', { class: 'model', text: ticket.recommendedModel }),
  ]);
  card.appendChild(idRow);

  card.appendChild(el('div', { class: 'title', text: ticket.title }));
  card.appendChild(el('div', { class: 'desc', text: ticket.description || '(sin objetivo)' }));

  const badge = el('span', {
    class: 'badge ' + ticket.rawState,
    text: ticket.rawState,
  });
  const depsWrap = el('div', { class: 'deps' });
  if (ticket.dependencies.length === 0) {
    depsWrap.appendChild(el('span', { class: 'dep-pill done', text: 'sin dependencias' }));
  } else {
    ticket.dependencies.forEach((d) => depsWrap.appendChild(depPill(d)));
  }
  card.appendChild(depsWrap);
  card.appendChild(badge);

  // Execute controls — FIX-003: human/business tickets (isHumanTask) get no
  // runner/model selector and no Execute button, since no agent process can
  // ever complete them; show an explanatory badge instead.
  if (ticket.isHumanTask) {
    card.appendChild(el('span', {
      class: 'human-task-badge',
      text: 'tarea humana — no ejecutable',
    }));
  } else {
    const saved = userSelections.get(ticket.id);
    const actions = el('div', { class: 'card-actions' });
    const runnerSelect = el('select', { class: 'runner-select' });
    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {
      runnerSelect.appendChild(el('option', { value: r, text: r }));
    });
    if (saved && [...runnerSelect.options].some((o) => o.value === saved.runner)) {
      runnerSelect.value = saved.runner;
    }

    const modelSelect = el('select', { class: 'model-select' });
    function refreshModelOptions() {
      modelSelect.innerHTML = '';
      if (runnerSelect.value === 'claude') {
        modelSelect.disabled = false;
        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])
          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));
      } else {
        modelSelect.disabled = true;
        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));
      }
      if (saved && [...modelSelect.options].some((o) => o.value === saved.model)) {
        modelSelect.value = saved.model;
      }
    }
    function saveSelection() {
      userSelections.set(ticket.id, { runner: runnerSelect.value, model: modelSelect.value });
    }
    runnerSelect.addEventListener('change', () => { refreshModelOptions(); saveSelection(); });
    modelSelect.addEventListener('change', saveSelection);
    refreshModelOptions();

    const canExecute = ticket.rawState === 'pending' || ticket.rawState === 'blocked' || ticket.rawState === 'failed';
    const execBtn = el('button', {
      class: 'primary small',
      text: ticket.hasActiveRun ? 'ejecutando…' : 'Ejecutar',
      disabled: (!canExecute || ticket.hasActiveRun) ? 'true' : null,
      onclick: () => executeTicket(ticket.id, runnerSelect.value, modelSelect.value),
    });
    if (!canExecute || ticket.hasActiveRun) execBtn.disabled = true;

    actions.appendChild(runnerSelect);
    actions.appendChild(modelSelect);
    actions.appendChild(execBtn);
    card.appendChild(actions);
  }

  const footer = el('div', { class: 'card-footer-links' }, [
    el('button', { class: 'link', text: 'ver log', onclick: () => openLogModal(ticket.id) }),
    el('button', { class: 'link', text: 'comentarios', onclick: () => openCommentsModal(ticket.id) }),
  ]);
  card.appendChild(footer);

  return card;
}

function render() {
  const columns = {
    'To Do': document.querySelector('[data-col="To Do"] .cards'),
    'In Progress': document.querySelector('[data-col="In Progress"] .cards'),
    'Blocked': document.querySelector('[data-col="Blocked"] .cards'),
    'Completed': document.querySelector('[data-col="Completed"] .cards'),
  };
  Object.values(columns).forEach((c) => (c.innerHTML = ''));
  const counts = { 'To Do': 0, 'In Progress': 0, 'Blocked': 0, 'Completed': 0 };

  ticketsCache
    .slice()
    .sort((a, b) => a.order - b.order)
    .forEach((t) => {
      const col = columns[t.runtimeState] || columns['To Do'];
      col.appendChild(buildCard(t));
      counts[t.runtimeState] = (counts[t.runtimeState] || 0) + 1;
    });

  document.getElementById('count-todo').textContent = counts['To Do'];
  document.getElementById('count-inprogress').textContent = counts['In Progress'];
  document.getElementById('count-blocked').textContent = counts['Blocked'];
  document.getElementById('count-completed').textContent = counts['Completed'];
}

async function executeTicket(ticketId, runner, model) {
  try {
    const payload = { ticket: ticketId, runner };
    if (runner === 'claude') payload.model = model;
    const data = await fetchJson('/api/execute', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (data.state === 'blocked') {
      showToast(ticketId + ' bloqueado: ' + data.message, true);
    } else {
      showToast(ticketId + ' lanzado (' + data.state + ')', false);
    }
    loadTickets();
  } catch (e) {
    showToast('Error ejecutando ' + ticketId + ': ' + e.message, true);
  }
}

function openModal(bodyNode) {
  const body = document.getElementById('modal-body');
  body.innerHTML = '';
  body.appendChild(bodyNode);
  document.getElementById('modal-backdrop').classList.add('open');
}
document.getElementById('modal-close').addEventListener('click', () => {
  document.getElementById('modal-backdrop').classList.remove('open');
});
document.getElementById('modal-backdrop').addEventListener('click', (e) => {
  if (e.target.id === 'modal-backdrop') e.currentTarget.classList.remove('open');
});

async function openLogModal(ticketId) {
  const wrap = el('div');
  wrap.appendChild(el('h3', { text: 'Logs — ' + ticketId }));
  const select = el('select');
  const pre = el('pre', { text: 'cargando…' });
  try {
    const data = await fetchJson('/api/logs?ticket=' + encodeURIComponent(ticketId));
    if (!data.logs.length) {
      pre.textContent = '(sin logs todavía)';
    } else {
      data.logs.forEach((f) => select.appendChild(el('option', { value: f, text: f })));
      const loadLog = async () => {
        pre.textContent = 'cargando…';
        try {
          const res = await fetch('/api/log?ticket=' + encodeURIComponent(ticketId) + '&file=' + encodeURIComponent(select.value));
          pre.textContent = await res.text();
        } catch (e) {
          pre.textContent = 'error: ' + e.message;
        }
      };
      select.addEventListener('change', loadLog);
      wrap.appendChild(select);
      loadLog();
    }
  } catch (e) {
    pre.textContent = 'error: ' + e.message;
  }
  wrap.appendChild(pre);
  openModal(wrap);
}

async function openCommentsModal(ticketId) {
  const wrap = el('div');
  wrap.appendChild(el('h3', { text: 'Comentarios — ' + ticketId }));
  const list = el('div');
  wrap.appendChild(list);

  const form = el('div', { style: 'margin-top:10px; display:flex; gap:6px; flex-wrap:wrap;' });
  const author = el('input', { placeholder: 'autor', value: 'dashboard-user' });
  const typeSel = el('select');
  ['note', 'completion', 'blocked'].forEach((t) => typeSel.appendChild(el('option', { value: t, text: t })));
  const msg = el('textarea', { placeholder: 'mensaje', rows: '2', style: 'flex:1; min-width:220px;' });
  const send = el('button', { class: 'primary small', text: 'Agregar' });
  form.appendChild(author);
  form.appendChild(typeSel);
  form.appendChild(msg);
  form.appendChild(send);
  wrap.appendChild(form);

  async function refresh() {
    list.innerHTML = 'cargando…';
    try {
      const data = await fetchJson('/api/comments?ticket=' + encodeURIComponent(ticketId));
      list.innerHTML = '';
      if (!data.comments.length) {
        list.appendChild(el('div', { class: 'comment', text: '(sin comentarios)' }));
      }
      data.comments.forEach((c) => {
        const item = el('div', { class: 'comment' });
        item.appendChild(el('div', { class: 'ctop', text: `${c.timestamp || ''} · ${c.author || '?'} · ${c.type || 'note'}` }));
        item.appendChild(el('div', { text: c.message || c.raw || '' }));
        list.appendChild(item);
      });
    } catch (e) {
      list.innerHTML = '';
      list.appendChild(el('div', { class: 'comment', text: 'error: ' + e.message }));
    }
  }

  send.addEventListener('click', async () => {
    if (!msg.value.trim()) return;
    try {
      await fetchJson('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticket: ticketId, author: author.value, type: typeSel.value, message: msg.value }),
      });
      msg.value = '';
      refresh();
    } catch (e) {
      showToast('Error agregando comentario: ' + e.message, true);
    }
  });

  await refresh();
  openModal(wrap);
}

async function init() {
  await loadAllowlists();
  await loadTickets();
  setInterval(loadTickets, REFRESH_MS);

