{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJ81WeCYVqHq2f7UPuZujY","type":"tool_result","content":"1\t/**\n2\t * INF-002 — Activity writer. All writes should leave an auditable trail.\n3\t */\n4\t\n5\tfunction activityLog_(type, tableName, after, before, patch, meta) {\n6\t  var sheet = getSheet_('Activity');\n7\t  var now = new Date().toISOString();\n8\t  var activityId = nextPrefixedId_('Activity');\n9\t  var ticketId = extractTicketId_(tableName, after, before, patch);\n10\t  var actor = (meta && meta.actor) || 'system';\n11\t  var entry = {\n12\t    activity_id: activityId,\n13\t    ticket_id: ticketId,\n14\t    at: now,\n15\t    actor: actor,\n16\t    type: type,\n17\t    from_state: (meta && meta.from_state) || '',\n18\t    to_state: (meta && meta.to_state) || '',\n19\t    message: buildActivityMessage_(type, tableName, after, before, patch, meta),\n20\t    meta_json: JSON.stringify(meta || {})\n21\t  };\n22\t  appendRow_(sheet, getTableSpec_('Activity').headers, entry);\n23\t  return entry;\n24\t}\n25\t\n26\tfunction extractTicketId_(tableName, after, before, patch) {\n27\t  if (after && after.ticket_id) {\n28\t    return after.ticket_id;\n29\t  }\n30\t  if (before && before.ticket_id) {\n31\t    return before.ticket_id;\n32\t  }\n33\t  if (patch && patch.ticket_id) {\n34\t    return patch.ticket_id;\n35\t  }\n36\t  return '';\n37\t}\n38\t\n39\tfunction buildActivityMessage_(type, tableName, after, before, patch, meta) {\n40\t  var parts = [type + ' ' + tableName];\n41\t  if (after && after.ticket_id) {\n42\t    parts.push(after.ticket_id);\n43\t  }\n44\t  if (meta && meta.note) {\n45\t    parts.push(meta.note);\n46\t  }\n47\t  return parts.join(' - ');\n48\t}\n49\t"}]},"parent_tool_use_id":null,"session_id":"50e8cbd0-7cab-4a32-a911-487d2caf7b4b","uuid":"af09ce25-89d6-4096-960c-ccaa07612446","timestamp":"2026-07-22T02:20:28.070Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/core/activity.gs","content":"/**\n * INF-002 — Activity writer. All writes should leave an auditable trail.\n */\n\nfunction activityLog_(type, tableName, after, before, patch, meta) {\n  var sheet = getSheet_('Activity');\n  var now = new Date().toISOString();\n  var activityId = nextPrefixedId_('Activity');\n  var ticketId = extractTicketId_(tableName, after, before, patch);\n  var actor = (meta && meta.actor) || 'system';\n  var entry = {\n    activity_id: activityId,\n    ticket_id: ticketId,\n    at: now,\n    actor: actor,\n    type: type,\n    from_state: (meta && meta.from_state) || '',\n    to_state: (meta && meta.to_state) || '',\n    message: buildActivityMessage_(type, tableName, after, before, patch, meta),\n    meta_json: JSON.stringify(meta || {})\n  };\n  appendRow_(sheet, getTableSpec_('Activity').headers, entry);\n  return entry;\n}\n\nfunction extractTicketId_(tableName, after, before, patch) {\n  if (after && after.ticket_id) {\n    return after.ticket_id;\n  }\n  if (before && before.ticket_id) {\n    return before.ticket_id;\n  }\n  if (patch && patch.ticket_id) {\n    return patch.ticket_id;\n  }\n  return '';\n}\n\nfunction buildActivityMessage_(type, tableName, after, before, patch, meta) {\n  var parts = [type + ' ' + tableName];\n  if (after && after.ticket_id) {\n    parts.push(after.ticket_id);\n  }\n  if (meta && meta.note) {\n    parts.push(meta.note);\n  }\n  return parts.join(' - ');\n}\n","numLines":49,"startLine":1,"totalLines":49}}}
