{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QkpYYNzGvaFd54Sv563PT9","type":"tool_result","content":"1\t/**\n2\t * INF-002 — Session identity and role resolution.\n3\t * Uses the active Google account email, then resolves the role from the\n4\t * Users tab seeded by INF-001.\n5\t */\n6\t\n7\tfunction getSession() {\n8\t  var email = getActiveUserEmail_();\n9\t  if (!email) {\n10\t    return { ok: false, status: 403, error: 'Sesión no autenticada' };\n11\t  }\n12\t\n13\t  var user = findUserByEmail_(email);\n14\t  if (!user || !user.active) {\n15\t    return { ok: false, status: 403, error: 'Usuario no autorizado', email: email };\n16\t  }\n17\t\n18\t  return {\n19\t    ok: true,\n20\t    email: email,\n21\t    role: user.role,\n22\t    fullName: user.full_name,\n23\t    user: user\n24\t  };\n25\t}\n26\t\n27\tfunction getActiveUserEmail_() {\n28\t  var activeUser = Session.getActiveUser();\n29\t  if (!activeUser) {\n30\t    return '';\n31\t  }\n32\t  return String(activeUser.getEmail ? activeUser.getEmail() : '').trim().toLowerCase();\n33\t}\n34\t\n35\tfunction findUserByEmail_(email) {\n36\t  var rows = db.read('Users', function (row) {\n37\t    return String(row.email || '').trim().toLowerCase() === String(email || '').trim().toLowerCase();\n38\t  });\n39\t  return rows.length ? rows[0] : null;\n40\t}\n41\t\n42\tfunction requireRole_(session, allowedRoles) {\n43\t  if (!session || !session.ok) {\n44\t    return { ok: false, status: 403, error: 'Sesión no autenticada' };\n45\t  }\n46\t  if (!allowedRoles || allowedRoles.length === 0) {\n47\t    return { ok: true };\n48\t  }\n49\t  if (allowedRoles.indexOf(session.role) === -1) {\n50\t    return { ok: false, status: 403, error: 'Rol no autorizado', allowed: allowedRoles };\n51\t  }\n52\t  return { ok: true };\n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"50e8cbd0-7cab-4a32-a911-487d2caf7b4b","uuid":"8b63e03c-e732-4cb4-88a1-bf377d02bb33","timestamp":"2026-07-22T02:20:48.113Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/core/session.gs","content":"/**\n * INF-002 — Session identity and role resolution.\n * Uses the active Google account email, then resolves the role from the\n * Users tab seeded by INF-001.\n */\n\nfunction getSession() {\n  var email = getActiveUserEmail_();\n  if (!email) {\n    return { ok: false, status: 403, error: 'Sesión no autenticada' };\n  }\n\n  var user = findUserByEmail_(email);\n  if (!user || !user.active) {\n    return { ok: false, status: 403, error: 'Usuario no autorizado', email: email };\n  }\n\n  return {\n    ok: true,\n    email: email,\n    role: user.role,\n    fullName: user.full_name,\n    user: user\n  };\n}\n\nfunction getActiveUserEmail_() {\n  var activeUser = Session.getActiveUser();\n  if (!activeUser) {\n    return '';\n  }\n  return String(activeUser.getEmail ? activeUser.getEmail() : '').trim().toLowerCase();\n}\n\nfunction findUserByEmail_(email) {\n  var rows = db.read('Users', function (row) {\n    return String(row.email || '').trim().toLowerCase() === String(email || '').trim().toLowerCase();\n  });\n  return rows.length ? rows[0] : null;\n}\n\nfunction requireRole_(session, allowedRoles) {\n  if (!session || !session.ok) {\n    return { ok: false, status: 403, error: 'Sesión no autenticada' };\n  }\n  if (!allowedRoles || allowedRoles.length === 0) {\n    return { ok: true };\n  }\n  if (allowedRoles.indexOf(session.role) === -1) {\n    return { ok: false, status: 403, error: 'Rol no autorizado', allowed: allowedRoles };\n  }\n  return { ok: true };\n}\n","numLines":54,"startLine":1,"totalLines":54}}}
