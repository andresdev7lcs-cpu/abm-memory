{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X1qmSSMrcv3m5D7woRXZgG","type":"tool_result","content":"1\t/**\n2\t * INF-003 — Drive case-file automation.\n3\t * Root `/WOOD_PANEL_OPERATIONS`, customer folders under `01_CUSTOMERS`, per-order\n4\t * folder trees with subfolders 00-07 (architecture.md §5, data-model.md#Documents).\n5\t * Folder 00-07 names mirror the Documents.category enum order exactly:\n6\t * original_request, normalized, confirmation, quotation, payment, production,\n7\t * delivery, closure — confirmed against roadmap.md's explicit anchors for\n8\t * 00_ORIGINAL_REQUEST, 03_QUOTATION, 04_PAYMENT, 05_PRODUCTION, 07_CLOSURE.\n9\t * Nothing in 00_ORIGINAL_REQUEST is ever overwritten or deleted (write-once).\n10\t */\n11\t\n12\tvar PANEL_OPS_DRIVE_ROOT_PROP = 'PANEL_OPS_DRIVE_ROOT_ID';\n13\tvar PANEL_OPS_DRIVE_ROOT_NAME = 'WOOD_PANEL_OPERATIONS';\n14\tvar PANEL_OPS_DRIVE_CUSTOMERS_FOLDER = '01_CUSTOMERS';\n15\t\n16\tvar PANEL_OPS_ORDER_SUBFOLDERS = [\n17\t  { category: 'original_request', name: '00_ORIGINAL_REQUEST' },\n18\t  { category: 'normalized', name: '01_NORMALIZED' },\n19\t  { category: 'confirmation', name: '02_CONFIRMATION' },\n20\t  { category: 'quotation', name: '03_QUOTATION' },\n21\t  { category: 'payment', name: '04_PAYMENT' },\n22\t  { category: 'production', name: '05_PRODUCTION' },\n23\t  { category: 'delivery', name: '06_DELIVERY' },\n24\t  { category: 'closure', name: '07_CLOSURE' }\n25\t];\n26\t\n27\tvar drive = {\n28\t  /**\n29\t   * Finds or creates the platform root folder. Idempotent: caches the id in\n30\t   * Script Properties (mirrors PANEL_OPS_SS_ID_PROP in core/db.gs) so repeat\n31\t   * calls never create duplicate roots even if the property is stale.\n32\t   */\n33\t  ensureRoot: function () {\n34\t    var props = PropertiesService.getScriptProperties();\n35\t    var cachedId = props.getProperty(PANEL_OPS_DRIVE_ROOT_PROP);\n36\t    if (cachedId) {\n37\t      try {\n38\t        var cached = DriveApp.getFolderById(cachedId);\n39\t        return cached;\n40\t      } catch (e) {\n41\t        // stale property (folder deleted/moved out of reach) — fall through and re-resolve\n42\t      }\n43\t    }\n44\t\n45\t    var root = findOrCreateFolder_(DriveApp.getRootFolder(), PANEL_OPS_DRIVE_ROOT_NAME);\n46\t    props.setProperty(PANEL_OPS_DRIVE_ROOT_PROP, root.getId());\n47\t    return root;\n48\t  },\n49\t\n50\t  /**\n51\t   * Creates (or returns existing) folder tree for one order:\n52\t   * root/01_CUSTOMERS/<customerName>/<ticketId>/00_ORIGINAL_REQUEST..07_CLOSURE\n53\t   */\n54\t  createOrderFolders: function (ticketId, customerName) {\n55\t    if (!ticketId) {\n56\t      throw new Error('createOrderFolders requires ticketId');\n57\t    }\n58\t    if (!customerName) {\n59\t      throw new Error('createOrderFolders requires customerName');\n60\t    }\n61\t\n62\t    var root = drive.ensureRoot();\n63\t    var customersRoot = findOrCreateFolder_(root, PANEL_OPS_DRIVE_CUSTOMERS_FOLDER);\n64\t    var customerFolder = findOrCreateFolder_(customersRoot, customerName);\n65\t    var orderFolder = findOrCreateFolder_(customerFolder, ticketId);\n66\t\n67\t    var subfolders = {};\n68\t    PANEL_OPS_ORDER_SUBFOLDERS.forEach(function (spec) {\n69\t      subfolders[spec.category] = findOrCreateFolder_(orderFolder, spec.name);\n70\t    });\n71\t\n72\t    return {\n73\t      customerFolder: customerFolder,\n74\t      orderFolder: orderFolder,\n75\t      subfolders: subfolders\n76\t    };\n77\t  },\n78\t\n79\t  /**\n80\t   * Stores blob into the order's per-category subfolder, writes a Documents\n81\t   * row, and enforces write-once on category `original_request`.\n82\t   */\n83\t  storeFile: function (ticketId, category, blob, meta) {\n84\t    if (!ticketId) {\n85\t      throw new Error('storeFile requires ticketId');\n86\t    }\n87\t    var subfolderSpec = getSubfolderSpecForCategory_(category);\n88\t    if (!subfolderSpec) {\n89\t      throw new Error('Unknown Documents category: ' + category);\n90\t    }\n91\t\n92\t    var orderFolder = findOrderFolder_(ticketId);\n93\t    if (!orderFolder) {\n94\t      throw new Error('No order folder found for ticket ' + ticketId + ' — call drive.createOrderFolders first');\n95\t    }\n96\t    var subfolder = findOrCreateFolder_(orderFolder, subfolderSpec.name);\n97\t\n98\t    var isImmutableCategory = category === 'original_request';\n99\t    if (isImmutableCategory && subfolder.getFiles().hasNext()) {\n100\t      throw new Error('Rejected: ' + subfolderSpec.name + ' is write-once — a file already exists for ticket ' + ticketId);\n101\t    }\n102\t\n103\t    var filename = buildStoredFilename_(ticketId, category, blob.getName());\n104\t    var file = subfolder.createFile(blob.setName(filename));\n105\t\n106\t    var record = db.insert('Documents', {\n107\t      ticket_id: ticketId,\n108\t      customer_id: (meta && meta.customerId) || '',\n109\t      category: category,\n110\t      filename: filename,\n111\t      drive_file_id: file.getId(),\n112\t      drive_url: file.getUrl(),\n113\t      immutable: isImmutableCategory,\n114\t      uploaded_by: (meta && meta.actor) || 'system',\n115\t      uploaded_at: new Date().toISOString()\n116\t    }, meta);\n117\t\n118\t    return record;\n119\t  }\n120\t};\n121\t\n122\tfunction getSubfolderSpecForCategory_(category) {\n123\t  for (var i = 0; i < PANEL_OPS_ORDER_SUBFOLDERS.length; i++) {\n124\t    if (PANEL_OPS_ORDER_SUBFOLDERS[i].category === category) {\n125\t      return PANEL_OPS_ORDER_SUBFOLDERS[i];\n126\t    }\n127\t  }\n128\t  return null;\n129\t}\n130\t\n131\tfunction buildStoredFilename_(ticketId, category, originalName) {\n132\t  return ticketId + '_' + category + '_' + originalName;\n133\t}\n134\t\n135\tfunction findOrCreateFolder_(parent, name) {\n136\t  var existing = parent.getFoldersByName(name);\n137\t  if (existing.hasNext()) {\n138\t    return existing.next();\n139\t  }\n140\t  return parent.createFolder(name);\n141\t}\n142\t\n143\t/**\n144\t * Locates an order's folder by exact name match under\n145\t * root/01_CUSTOMERS/*\\/<ticketId>. Ticket IDs are opaque, server-generated,\n146\t * and never reused (architecture.md §6 invariant 10), so an exact-name\n147\t * search is unambiguous.\n148\t */\n149\tfunction findOrderFolder_(ticketId) {\n150\t  var root = drive.ensureRoot();\n151\t  var customersRoot = findOrCreateFolder_(root, PANEL_OPS_DRIVE_CUSTOMERS_FOLDER);\n152\t  var customerFolders = customersRoot.getFolders();\n153\t  while (customerFolders.hasNext()) {\n154\t    var customerFolder = customerFolders.next();\n155\t    var orderFolders = customerFolder.getFoldersByName(ticketId);\n156\t    if (orderFolders.hasNext()) {\n157\t      return orderFolders.next();\n158\t    }\n159\t  }\n160\t  return null;\n161\t}\n162\t"}]},"parent_tool_use_id":null,"session_id":"50e8cbd0-7cab-4a32-a911-487d2caf7b4b","uuid":"7d15e176-eeb4-4fa8-bac1-dd7ad4cc27d1","timestamp":"2026-07-22T02:24:06.698Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/drive/drive.gs","content":"/**\n * INF-003 — Drive case-file automation.\n * Root `/WOOD_PANEL_OPERATIONS`, customer folders under `01_CUSTOMERS`, per-order\n * folder trees with subfolders 00-07 (architecture.md §5, data-model.md#Documents).\n * Folder 00-07 names mirror the Documents.category enum order exactly:\n * original_request, normalized, confirmation, quotation, payment, production,\n * delivery, closure — confirmed against roadmap.md's explicit anchors for\n * 00_ORIGINAL_REQUEST, 03_QUOTATION, 04_PAYMENT, 05_PRODUCTION, 07_CLOSURE.\n * Nothing in 00_ORIGINAL_REQUEST is ever overwritten or deleted (write-once).\n */\n\nvar PANEL_OPS_DRIVE_ROOT_PROP = 'PANEL_OPS_DRIVE_ROOT_ID';\nvar PANEL_OPS_DRIVE_ROOT_NAME = 'WOOD_PANEL_OPERATIONS';\nvar PANEL_OPS_DRIVE_CUSTOMERS_FOLDER = '01_CUSTOMERS';\n\nvar PANEL_OPS_ORDER_SUBFOLDERS = [\n  { category: 'original_request', name: '00_ORIGINAL_REQUEST' },\n  { category: 'normalized', name: '01_NORMALIZED' },\n  { category: 'confirmation', name: '02_CONFIRMATION' },\n  { category: 'quotation', name: '03_QUOTATION' },\n  { category: 'payment', name: '04_PAYMENT' },\n  { category: 'production', name: '05_PRODUCTION' },\n  { category: 'delivery', name: '06_DELIVERY' },\n  { category: 'closure', name: '07_CLOSURE' }\n];\n\nvar drive = {\n  /**\n   * Finds or creates the platform root folder. Idempotent: caches the id in\n   * Script Properties (mirrors PANEL_OPS_SS_ID_PROP in core/db.gs) so repeat\n   * calls never create duplicate roots even if the property is stale.\n   */\n  ensureRoot: function () {\n    var props = PropertiesService.getScriptProperties();\n    var cachedId = props.getProperty(PANEL_OPS_DRIVE_ROOT_PROP);\n    if (cachedId) {\n      try {\n        var cached = DriveApp.getFolderById(cachedId);\n        return cached;\n      } catch (e) {\n        // stale property (folder deleted/moved out of reach) — fall through and re-resolve\n      }\n    }\n\n    var root = findOrCreateFolder_(DriveApp.getRootFolder(), PANEL_OPS_DRIVE_ROOT_NAME);\n    props.setProperty(PANEL_OPS_DRIVE_ROOT_PROP, root.getId());\n    return root;\n  },\n\n  /**\n   * Creates (or returns existing) folder tree for one order:\n   * root/01_CUSTOMERS/<customerName>/<ticketId>/00_ORIGINAL_REQUEST..07_CLOSURE\n   */\n  createOrderFolders: function (ticketId, customerName) {\n    if (!ticketId) {\n      throw new Error('createOrderFolders requires ticketId');\n    }\n    if (!customerName) {\n      throw new Error('createOrderFolders requires customerName');\n    }\n\n    var root = drive.ensureRoot();\n    var customersRoot = findOrCreateFolder_(root, PANEL_OPS_DRIVE_CUSTOMERS_FOLDER);\n    var customerFolder = findOrCreateFolder_(customersRoot, customerName);\n    var orderFolder = findOrCreateFolder_(customerFolder, ticketId);\n\n    var subfolders = {};\n    PANEL_OPS_ORDER_SUBFOLDERS.forEach(function (spec) {\n      subfolders[spec.category] = findOrCreateFolder_(orderFolder, spec.name);\n    });\n\n    return {\n      customerFolder: customerFolder,\n      orderFolder: orderFolder,\n      subfolders: subfolders\n    };\n  },\n\n  /**\n   * Stores blob into the order's per-category subfolder, writes a Documents\n   * row, and enforces write-once on category `original_request`.\n   */\n  storeFile: function (ticketId, category, blob, meta) {\n    if (!ticketId) {\n      throw new Error('storeFile requires ticketId');\n    }\n    var subfolderSpec = getSubfolderSpecForCategory_(category);\n    if (!subfolderSpec) {\n      throw new Error('Unknown Documents category: ' + category);\n    }\n\n    var orderFolder = findOrderFolder_(ticketId);\n    if (!orderFolder) {\n      throw new Error('No order folder found for ticket ' + ticketId + ' — call drive.createOrderFolders first');\n    }\n    var subfolder = findOrCreateFolder_(orderFolder, subfolderSpec.name);\n\n    var isImmutableCategory = category === 'original_request';\n    if (isImmutableCategory && subfolder.getFiles().hasNext()) {\n      throw new Error('Rejected: ' + subfolderSpec.name + ' is write-once — a file already exists for ticket ' + ticketId);\n    }\n\n    var filename = buildStoredFilename_(ticketId, category, blob.getName());\n    var file = subfolder.createFile(blob.setName(filename));\n\n    var record = db.insert('Documents', {\n      ticket_id: ticketId,\n      customer_id: (meta && meta.customerId) || '',\n      category: category,\n      filename: filename,\n      drive_file_id: file.getId(),\n      drive_url: file.getUrl(),\n      immutable: isImmutableCategory,\n      uploaded_by: (meta && meta.actor) || 'system',\n      uploaded_at: new Date().toISOString()\n    }, meta);\n\n    return record;\n  }\n};\n\nfunction getSubfolderSpecForCategory_(category) {\n  for (var i = 0; i < PANEL_OPS_ORDER_SUBFOLDERS.length; i++) {\n    if (PANEL_OPS_ORDER_SUBFOLDERS[i].category === category) {\n      return PANEL_OPS_ORDER_SUBFOLDERS[i];\n    }\n  }\n  return null;\n}\n\nfunction buildStoredFilename_(ticketId, category, originalName) {\n  return ticketId + '_' + category + '_' + originalName;\n}\n\nfunction findOrCreateFolder_(parent, name) {\n  var existing = parent.getFoldersByName(name);\n  if (existing.hasNext()) {\n    return existing.next();\n  }\n  return parent.createFolder(name);\n}\n\n/**\n * Locates an order's folder by exact name match under\n * root/01_CUSTOMERS/*\\/<ticketId>. Ticket IDs are opaque, server-generated,\n * and never reused (architecture.md §6 invariant 10), so an exact-name\n * search is unambiguous.\n */\nfunction findOrderFolder_(ticketId) {\n  var root = drive.ensureRoot();\n  var customersRoot = findOrCreateFolder_(root, PANEL_OPS_DRIVE_CUSTOMERS_FOLDER);\n  var customerFolders = customersRoot.getFolders();\n  while (customerFolders.hasNext()) {\n    var customerFolder = customerFolders.next();\n    var orderFolders = customerFolder.getFoldersByName(ticketId);\n    if (orderFolders.hasNext()) {\n      return orderFolders.next();\n    }\n  }\n  return null;\n}\n","numLines":162,"startLine":1,"totalLines":162}}}
