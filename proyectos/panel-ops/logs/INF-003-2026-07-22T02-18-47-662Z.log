{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LEVj6ACnYWZxJdQW8b3LUV","type":"tool_result","content":"1\t/**\n2\t * FIX-006 — Automated test suite covering INF-002's acceptance criteria.\n3\t * Manual-run pattern (mirrors setup/selfCheck.gs): each check returns\n4\t * {name, pass, detail}; runInf002Tests() runs all 4 and logs PASS/FAIL +\n5\t * a summary line. Uses one disposable Loss_Reasons row for the round-trip\n6\t * and Activity checks, deactivated (soft-delete) at the end so re-runs\n7\t * don't accumulate junk data.\n8\t */\n9\t\n10\tfunction runInf002Tests() {\n11\t  var results = [];\n12\t  results.push(testUnknownEmailRejected_());\n13\t  results.push(testSequenceIncrementsAtomically_());\n14\t\n15\t  var fixture = insertFix006TestLossReason_();\n16\t  results.push(testInsertReadRoundTrip_(fixture));\n17\t  results.push(testActivityRowOnWrite_(fixture));\n18\t  deactivateFix006TestLossReason_(fixture.record.reason_id, fixture.tag);\n19\t\n20\t  var allPass = results.every(function (r) { return r.pass; });\n21\t  results.forEach(function (r) {\n22\t    Logger.log((r.pass ? 'PASS' : 'FAIL') + ' — ' + r.name + (r.detail ? ' — ' + r.detail : ''));\n23\t  });\n24\t  Logger.log('runInf002Tests ' + (allPass ? 'ALL PASS' : 'FAILURES PRESENT') +\n25\t    ' (' + results.length + ' checks)');\n26\t  return { allPass: allPass, results: results };\n27\t}\n28\t\n29\tfunction testUnknownEmailRejected_() {\n30\t  var fabricated = 'fix006-nonexistent-' + new Date().getTime() + '@example.invalid';\n31\t  var user = findUserByEmail_(fabricated);\n32\t  return {\n33\t    name: 'getSession rejects unknown/nonexistent email',\n34\t    pass: user === null,\n35\t    detail: user === null\n36\t      ? 'findUserByEmail_ found no match — getSession() takes the ok:false branch for this email'\n37\t      : 'unexpected match found for a fabricated email'\n38\t  };\n39\t}\n40\t\n41\tfunction testSequenceIncrementsAtomically_() {\n42\t  var ok = true;\n43\t  var detail = '';\n44\t  withPanelOpsLock_(function () {\n45\t    var seen = {};\n46\t    var prev = -1;\n47\t    for (var i = 0; i < 20; i++) {\n48\t      var id = nextPrefixedId_('Loss_Reasons');\n49\t      if (seen[id]) {\n50\t        ok = false;\n51\t        detail = 'duplicate id: ' + id;\n52\t        break;\n53\t      }\n54\t      seen[id] = true;\n55\t      var n = Number(id.split('-')[1]);\n56\t      if (n <= prev) {\n57\t        ok = false;\n58\t        detail = 'non-increasing sequence at ' + id;\n59\t        break;\n60\t      }\n61\t      prev = n;\n62\t    }\n63\t  });\n64\t  return {\n65\t    name: 'sequence generator strictly increasing, no duplicates (20 iterations)',\n66\t    pass: ok,\n67\t    detail: detail || '20 ids generated, strictly increasing, no duplicates'\n68\t  };\n69\t}\n70\t\n71\tfunction insertFix006TestLossReason_() {\n72\t  var tag = 'FIX006-test-' + new Date().getTime();\n73\t  var record = db.insert('Loss_Reasons', {\n74\t    label_es: tag,\n75\t    active: true\n76\t  }, { actor: 'test:FIX-006', note: tag });\n77\t  return { record: record, tag: tag };\n78\t}\n79\t\n80\tfunction testInsertReadRoundTrip_(fixture) {\n81\t  var rows = db.read('Loss_Reasons', function (row) {\n82\t    return row.reason_id === fixture.record.reason_id;\n83\t  });\n84\t  var pass = rows.length === 1 && rows[0].label_es === fixture.record.label_es;\n85\t  return {\n86\t    name: 'Loss_Reasons insert+read round-trip',\n87\t    pass: pass,\n88\t    detail: pass ? rows[0].reason_id + ' round-tripped' : 'expected 1 matching row, got ' + rows.length\n89\t  };\n90\t}\n91\t\n92\tfunction testActivityRowOnWrite_(fixture) {\n93\t  var expectedMessage = 'insert Loss_Reasons - ' + fixture.tag;\n94\t  var rows = db.read('Activity', function (row) {\n95\t    return row.message === expectedMessage;\n96\t  });\n97\t  return {\n98\t    name: 'Activity row appended on write',\n99\t    pass: rows.length === 1,\n100\t    detail: rows.length + ' Activity row(s) matched \"' + expectedMessage + '\"'\n101\t  };\n102\t}\n103\t\n104\tfunction deactivateFix006TestLossReason_(reasonId, tag) {\n105\t  db.update('Loss_Reasons', function (row) {\n106\t    return row.reason_id === reasonId;\n107\t  }, { active: false }, { actor: 'test:FIX-006', note: 'cleanup ' + tag });\n108\t}\n109\t"}]},"parent_tool_use_id":null,"session_id":"50e8cbd0-7cab-4a32-a911-487d2caf7b4b","uuid":"01ddd3b5-867a-45bc-86fd-813d49ceb459","timestamp":"2026-07-22T02:20:38.177Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/work945/Documents/Proyectos/ABM/proyectos/panel-ops/src/gas/core/tests.gs","content":"/**\n * FIX-006 — Automated test suite covering INF-002's acceptance criteria.\n * Manual-run pattern (mirrors setup/selfCheck.gs): each check returns\n * {name, pass, detail}; runInf002Tests() runs all 4 and logs PASS/FAIL +\n * a summary line. Uses one disposable Loss_Reasons row for the round-trip\n * and Activity checks, deactivated (soft-delete) at the end so re-runs\n * don't accumulate junk data.\n */\n\nfunction runInf002Tests() {\n  var results = [];\n  results.push(testUnknownEmailRejected_());\n  results.push(testSequenceIncrementsAtomically_());\n\n  var fixture = insertFix006TestLossReason_();\n  results.push(testInsertReadRoundTrip_(fixture));\n  results.push(testActivityRowOnWrite_(fixture));\n  deactivateFix006TestLossReason_(fixture.record.reason_id, fixture.tag);\n\n  var allPass = results.every(function (r) { return r.pass; });\n  results.forEach(function (r) {\n    Logger.log((r.pass ? 'PASS' : 'FAIL') + ' — ' + r.name + (r.detail ? ' — ' + r.detail : ''));\n  });\n  Logger.log('runInf002Tests ' + (allPass ? 'ALL PASS' : 'FAILURES PRESENT') +\n    ' (' + results.length + ' checks)');\n  return { allPass: allPass, results: results };\n}\n\nfunction testUnknownEmailRejected_() {\n  var fabricated = 'fix006-nonexistent-' + new Date().getTime() + '@example.invalid';\n  var user = findUserByEmail_(fabricated);\n  return {\n    name: 'getSession rejects unknown/nonexistent email',\n    pass: user === null,\n    detail: user === null\n      ? 'findUserByEmail_ found no match — getSession() takes the ok:false branch for this email'\n      : 'unexpected match found for a fabricated email'\n  };\n}\n\nfunction testSequenceIncrementsAtomically_() {\n  var ok = true;\n  var detail = '';\n  withPanelOpsLock_(function () {\n    var seen = {};\n    var prev = -1;\n    for (var i = 0; i < 20; i++) {\n      var id = nextPrefixedId_('Loss_Reasons');\n      if (seen[id]) {\n        ok = false;\n        detail = 'duplicate id: ' + id;\n        break;\n      }\n      seen[id] = true;\n      var n = Number(id.split('-')[1]);\n      if (n <= prev) {\n        ok = false;\n        detail = 'non-increasing sequence at ' + id;\n        break;\n      }\n      prev = n;\n    }\n  });\n  return {\n    name: 'sequence generator strictly increasing, no duplicates (20 iterations)',\n    pass: ok,\n    detail: detail || '20 ids generated, strictly increasing, no duplicates'\n  };\n}\n\nfunction insertFix006TestLossReason_() {\n  var tag = 'FIX006-test-' + new Date().getTime();\n  var record = db.insert('Loss_Reasons', {\n    label_es: tag,\n    active: true\n  }, { actor: 'test:FIX-006', note: tag });\n  return { record: record, tag: tag };\n}\n\nfunction testInsertReadRoundTrip_(fixture) {\n  var rows = db.read('Loss_Reasons', function (row) {\n    return row.reason_id === fixture.record.reason_id;\n  });\n  var pass = rows.length === 1 && rows[0].label_es === fixture.record.label_es;\n  return {\n    name: 'Loss_Reasons insert+read round-trip',\n    pass: pass,\n    detail: pass ? rows[0].reason_id + ' round-tripped' : 'expected 1 matching row, got ' + rows.length\n  };\n}\n\nfunction testActivityRowOnWrite_(fixture) {\n  var expectedMessage = 'insert Loss_Reasons - ' + fixture.tag;\n  var rows = db.read('Activity', function (row) {\n    return row.message === expectedMessage;\n  });\n  return {\n    name: 'Activity row appended on write',\n    pass: rows.length === 1,\n    detail: rows.length + ' Activity row(s) matched \"' + expectedMessage + '\"'\n  };\n}\n\nfunction deactivateFix006TestLossReason_(reasonId, tag) {\n  db.update('Loss_Reasons', function (row) {\n    return row.reason_id === reasonId;\n  }, { active: false }, { actor: 'test:FIX-006', note: 'cleanup ' + tag });\n}\n","numLines":109,"startLine":1,"totalLines":109}}}
