font-size: 12px; color: var(--muted); }\n  #board {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(260px, 1fr));\n    gap: 14px;\n    padding: 16px;\n    align-items: start;\n  }\n  .column {\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 10px;\n    min-height: 200px;\n  }\n  .column h2 {\n    font-size: 13px;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: var(--muted);\n    margin: 4px 6px 10px;\n    display: flex;\n    justify-content: space-between;\n  }\n  .card {\n    background: var(--panel-2);\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    padding: 10px 12px;\n    margin-bottom: 10px;\n    font-size: 13px;\n  }\n  .card .id-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 4px;\n  }\n  .card .id { font-weight: 700; color: var(--accent); font-size: 12.5px; }\n  .card .model {\n    font-size: 10.5px;\n    color: var(--muted);\n    border: 1px solid var(--border);\n    border-radius: 6px;\n    padding: 1px 6px;\n  }\n  .card .title { font-weight: 600; margin-bottom: 6px; }\n  .card .desc { color: var(--muted); font-size: 12px; margin-bottom: 8px; line-height: 1.4; }\n  .card .deps { font-size: 11.5px; margin-bottom: 8px; }\n  .dep-pill {\n    display: inline-block;\n    padding: 1px 6px;\n    border-radius: 10px;\n    font-size: 10.5px;\n    margin: 2px 3px 0 0;\n    border: 1px solid var(--border);\n  }\n  .dep-pill.done { color: var(--green); border-color: var(--green); }\n  .dep-pill.pending { color: var(--yellow); border-color: var(--yellow); }\n  .badge {\n    font-size: 10px;\n    padding: 1px 6px;\n    border-radius: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.03em;\n  }\n  .badge.pending { background: #3a3620; color: var(--yellow); }\n  .badge.in_progress { background: #1d2f45; color: var(--blue); }\n  .badge.completed { background: #17331f; color: var(--green); }\n  .badge.blocked, .badge.failed { background: #3a1c1c; color: var(--red); }\n  .human-task-badge {\n    display: inline-block;\n    margin-top: 8px;\n    font-size: 11px;\n    padding: 3px 8px;\n    border-radius: 6px;\n    background: #2a2438;\n    color: #c79bf0;\n    border: 1px solid #4a3a63;\n  }\n  .card-actions {\n    display: flex;\n    gap: 6px;\n    flex-wrap: wrap;\n    margin-top: 8px;\n  }\n  select, button, input, textarea {\n    background: var(--panel);\n    color: var(--text);\n    border: 1px solid var(--border);\n    border-radius: 6px;\n    padding: 4px 6px;\n    font-size: 11.5px;\n  }\n  button {\n    cursor: pointer;\n  }\n  button.primary { background: var(--accent); border-color: var(--accent); color: #06101f; font-weight: 600; }\n  button:disabled { opacity: 0.5; cursor: not-allowed; }\n  button.small { padding: 3px 8px; }\n  .card-footer-links {\n    margin-top: 6px;\n    display: flex;\n    gap: 10px;\n  }\n  .link {\n    color: var(--muted);\n    font-size: 11px;\n    text-decoration: underline;\n    cursor: pointer;\n    background: none;\n    border: none;\n    padding: 0;\n  }\n  .modal-backdrop {\n    position: fixed; inset: 0; background: rgba(0,0,0,0.55);\n    display: none; align-items: center; justify-content: center; z-index: 50;\n  }\n  .modal-backdrop.open { display: flex; }\n  .modal {\n    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;\n    width: min(720px, 92vw); max-height: 82vh; overflow: auto; padding: 16px;\n  }\n  .modal h3 { margin-top: 0; font-size: 14px; }\n  .modal pre {\n    background: #0b0e12; padding: 10px; border-radius: 6px; font-size: 11.5px;\n    white-space: pre-wrap; word-break: break-word; max-height: 40vh; overflow: auto;\n  }\n  .modal .comment {\n    border-bottom: 1px solid var(--border);\n    padding: 6px 0;\n    font-size: 12px;\n  }\n  .modal .comment .ctop { color: var(--muted); font-size: 10.5px; margin-bottom: 2px; }\n  .modal-close {\n    float: right; cursor: pointer; color: var(--muted); background: none; border: none; font-size: 14px;\n  }\n  .toast {\n    position: fixed; bottom: 16px; right: 16px; background: var(--panel-2);\n    border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px;\n    font-size: 12.5px; max-width: 380px; z-index: 60; display: none;\n  }\n  .toast.error { border-color: var(--red); color: var(--red); }\n  .toast.open { display: block; }\n  #status-bar {\n    font-size: 11px; color: var(--muted); padding: 0 20px 10px;\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>Panel-Ops — Roadmap Execution Dashboard (GOV-001)</h1>\n  <div class=\"meta\" id=\"refresh-meta\">cargando…</div>\n</header>\n<div id=\"status-bar\">roadmap.md es solo lectura. Todo estado en tiempo real vive en roadmap-status.md, logs/ y comments/.</div>\n\n<div id=\"board\">\n  <div class=\"column\" data-col=\"To Do\"><h2>To Do <span id=\"count-todo\">0</span></h2><div class=\"cards\"></div></div>\n  <div class=\"column\" data-col=\"In Progress\"><h2>In Progress <span id=\"count-inprogress\">0</span></h2><div class=\"cards\"></div></div>\n  <div class=\"column\" data-col=\"Blocked\"><h2>Blocked <span id=\"count-blocked\">0</span></h2><div class=\"cards\"></div></div>\n  <div class=\"column\" data-col=\"Completed\"><h2>Completed <span id=\"count-completed\">0</span></h2><div class=\"cards\"></div></div>\n</div>\n\n<div class=\"modal-backdrop\" id=\"modal-backdrop\">\n  <div class=\"modal\" id=\"modal\">\n    <button class=\"modal-close\" id=\"modal-close\">cerrar ✕</button>\n    <div id=\"modal-body\"></div>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nconst REFRESH_MS = 4000;\nlet ticketsCache = [];\nlet allowlists = { models: [], runners: [] };\n\nfunction el(tag, attrs = {}, children = []) {\n  const node = document.createElement(tag);\n  for (const [k, v] of Object.entries(attrs)) {\n    if (k === 'class') node.className = v;\n    else if (k === 'text') node.textContent = v;\n    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);\n    else if (v === null || v === undefined || v === false) continue;\n    else node.setAttribute(k, v);\n  }\n  for (const c of children) node.appendChild(c);\n  return node;\n}\n\nfunction showToast(message, isError) {\n  const t = document.getElementById('toast');\n  t.textContent = message;\n  t.className = 'toast open' + (isError ? ' error' : '');\n  clearTimeout(showToast._timer);\n  showToast._timer = setTimeout(() => { t.className = 'toast'; }, 5000);\n}\n\nasync function fetchJson(url, opts) {\n  const res = await fetch(url, opts);\n  let body;\n  try { body = await res.json(); } catch { body = null; }\n  if (!res.ok) {\n    const msg = (body && body.error) ? body.error : `HTTP ${res.status}`;\n    const err = new Error(msg);\n    err.status = res.status;\n    err.body = body;\n    throw err;\n  }\n  return body;\n}\n\nasync function loadAllowlists() {\n  try {\n    const data = await fetchJson('/api/allowlists');\n    allowlists = data;\n  } catch (e) {\n    console.error(e);\n  }\n}\n\nasync function loadTickets() {\n  try {\n    const data = await fetchJson('/api/tickets');\n    ticketsCache = data.tickets;\n    render();\n    document.getElementById('refresh-meta').textContent =\n      'actualizado ' + new Date().toLocaleTimeString() + ' — ' + data.count + ' tickets';\n  } catch (e) {\n    document.getElementById('refresh-meta').textContent = 'error al refrescar: ' + e.message;\n  }\n}\n\nfunction depPill(dep) {\n  return el('span', {\n    class: 'dep-pill ' + (dep.completed ? 'done' : 'pending'),\n    text: dep.id + (dep.completed ? ' ✓' : ' …'),\n  });\n}\n\nfunction buildCard(ticket) {\n  const card = el('div', { class: 'card', 'data-ticket': ticket.id });\n\n  const idRow = el('div', { class: 'id-row' }, [\n    el('span', { class: 'id', text: ticket.id }),\n    el('span', { class: 'model', text: ticket.recommendedModel }),\n  ]);\n  card.appendChild(idRow);\n\n  card.appendChild(el('div', { class: 'title', text: ticket.title }));\n  card.appendChild(el('div', { class: 'desc', text: ticket.description || '(sin objetivo)' }));\n\n  const badge = el('span', {\n    class: 'badge ' + ticket.rawState,\n    text: ticket.rawState,\n  });\n  const depsWrap = el('div', { class: 'deps' });\n  if (ticket.dependencies.length === 0) {\n    depsWrap.appendChild(el('span', { class: 'dep-pill done', text: 'sin dependencias' }));\n  } else {\n    ticket.dependencies.forEach((d) => depsWrap.appendChild(depPill(d)));\n  }\n  card.appendChild(depsWrap);\n  card.appendChild(badge);\n\n  // Execute controls — FIX-003: human/business tickets (isHumanTask) get no\n  // runner/model selector and no Execute button, since no agent process can\n  // ever complete them; show an explanatory badge instead.\n  if (ticket.isHumanTask) {\n    card.appendChild(el('span', {\n      class: 'human-task-badge',\n      text: 'tarea humana — no ejecutable',\n    }));\n  } else {\n    const actions = el('div', { class: 'card-actions' });\n    const runnerSelect = el('select', { class: 'runner-select' });\n    (allowlists.runners.length ? allowlists.runners : ['claude', 'codex']).forEach((r) => {\n      runnerSelect.appendChild(el('option', { value: r, text: r }));\n    });\n\n    const modelSelect = el('select', { class: 'model-select' });\n    function refreshModelOptions() {\n      modelSelect.innerHTML = '';\n      if (runnerSelect.value === 'claude') {\n        modelSelect.disabled = false;\n        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])\n          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));\n      } else {\n        modelSelect.disabled = true;\n        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));\n      }\n    }\n    runnerSelect.addEventListener('change', refreshModelOptions);\n    refreshModelOptions();\n\n    const canExecute = ticket.rawState === 'pending' || ticket.rawState === 'blocked' || ticket.rawState === 'failed';\n    const execBtn = el('button', {\n      class: 'primary small',\n      text: ticket.hasActiveRun ? 'ejecutando…' : 'Ejecutar',\n      disabled: (!canExecute || ticket.hasActiveRun) ? 'true' : null,\n      onclick: () => executeTicket(ticket.id, runnerSelect.value, modelSelect.value),\n    });\n    if (!canExecute || ticket.hasActiveRun) execBtn.disabled = true;\n\n    actions.appendChild(runnerSelect);\n    actions.appendChild(modelSelect);\n    actions.appendChild(execBtn);\n    card.appendChild(actions);\n  }\n\n  const footer = el('div', { class: 'card-footer-links' }, [\n    el('button', { class: 'link', text: 'ver log', onclick: () => openLogModal(ticket.id) }),\n    el('button', { class: 'link', text: 'comentarios', onclick: () => openCommentsModal(ticket.id) }),\n  ]);\n  card.appendChild(footer);\n\n  return card;\n}\n\nfunction render() {\n  const columns = {\n    'To Do': document.querySelector('[data-col=\"To Do\"] .cards'),\n    'In Progress': document.querySelector('[data-col=\"In Progress\"] .cards'),\n    'Blocked': document.querySelector('[data-col=\"Blocked\"] .cards'),\n    'Completed': document.querySelector('[data-col=\"Completed\"] .cards'),\n  };\n  Object.values(columns).forEach((c) => (c.innerHTML = ''));\n  const counts = { 'To Do': 0, 'In Progress': 0, 'Blocked': 0, 'Completed': 0 };\n\n  ticketsCache\n    .slice()\n    .sort((a, b) => a.order - b.order)\n    .forEach((t) => {\n      const col = columns[t.runtimeState] || columns['To Do'];\n      col.appendChild(buildCard(t));\n      counts[t.runtimeState] = (counts[t.runtimeState] || 0) + 1;\n    });\n\n  document.getElementById('count-todo').textContent = counts['To Do'];\n  document.getElementById('count-inprogress').textContent = counts['In Progress'];\n  document.getElementById('count-blocked').textContent = counts['Blocked'];\n  document.getElementById('count-completed').textContent = counts['Completed'];\n}\n\nasync function executeTicket(ticketId, runner, model) {\n  try {\n    const payload = { ticket: ticketId, runner };\n    if (runner === 'claude') payload.model = model;\n    const data = await fetchJson('/api/execute', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(payload),\n    });\n    if (data.state === 'blocked') {\n      showToast(ticketId + ' bloqueado: ' + data.message, true);\n    } else {\n      showToast(ticketId + ' lanzado (' + data.state + ')', false);\n    }\n    loadTickets();\n  } catch (e) {\n    showToast('Error ejecutando ' + ticketId + ': ' + e.message, true);\n  }\n}\n\nfunction openModal(bodyNode) {\n  const body = document.getElementById('modal-body');\n  body.innerHTML = '';\n  body.appendChild(bodyNode);\n  document.getElementById('modal-backdrop').classList.add('open');\n}\ndocument.getElementById('modal-close').addEventListener('click', () => {\n  document.getElementById('modal-backdrop').classList.remove('open');\n});\ndocument.getElementById('modal-backdrop').addEventListener('click', (e) => {\n  if (e.target.id === 'modal-backdrop') e.currentTarget.classList.remove('open');\n});\n\nasync function openLogModal(ticketId) {\n  const wrap = el('div');\n  wrap.appendChild(el('h3', { text: 'Logs — ' + ticketId }));\n  const select = el('select');\n  const pre = el('pre', { text: 'cargando…' });\n  try {\n    const data = await fetchJson('/api/logs?ticket=' + encodeURIComponent(ticketId));\n    if (!data.logs.length) {\n      pre.textContent = '(sin logs todavía)';\n    } else {\n      data.logs.forEach((f) => select.appendChild(el('option', { value: f, text: f })));\n      const loadLog = async () => {\n        pre.textContent = 'cargando…';\n        try {\n          const res = await fetch('/api/log?ticket=' + encodeURIComponent(ticketId) + '&file=' + encodeURIComponent(select.value));\n          pre.textContent = await res.text();\n        } catch (e) {\n          pre.textContent = 'error: ' + e.message;\n        }\n      };\n      select.addEventListener('change', loadLog);\n      wrap.appendChild(select);\n      loadLog();\n    }\n  } catch (e) {\n    pre.textContent = 'error: ' + e.message;\n  }\n  wrap.appendChild(pre);\n  openModal(wrap);\n}\n\nasync function openCommentsModal(ticketId) {\n  const wrap = el('div');\n  wrap.appendChild(el('h3', { text: 'Comentarios — ' + ticketId }));\n  const list = el('div');\n  wrap.appendChild(list);\n\n  const form = el('div', { style: 'margin-top:10px; display:flex; gap:6px; flex-wrap:wrap;' });\n  const author = el('input', { placeholder: 'autor', value: 'dashboard-user' });\n  const typeSel = el('select');\n  ['note', 'completion', 'blocked'].forEach((t) => typeSel.appendChild(el('option', { value: t, text: t })));\n  const msg = el('textarea', { placeholder: 'mensaje', rows: '2', style: 'flex:1; min-width:220px;' });\n  const send = el('button', { class: 'primary small', text: 'Agregar' });\n  form.appendChild(author);\n  form.appendChild(typeSel);\n  form.appendChild(msg);\n  form.appendChild(send);\n  wrap.appendChild(form);\n\n  async function refresh() {\n    list.innerHTML = 'cargando…';\n    try {\n      const data = await fetchJson('/api/comments?ticket=' + encodeURIComponent(ticketId));\n      list.innerHTML = '';\n      if (!data.comments.length) {\n        list.appendChild(el('div', { class: 'comment', text: '(sin comentarios)' }));\n      }\n      data.comments.forEach((c) => {\n        const item = el('div', { class: 'comment' });\n        item.appendChild(el('div', { class: 'ctop', text: `${c.timestamp || ''} · ${c.author || '?'} · ${c.type || 'note'}` }));\n        item.appendChild(el('div', { text: c.message || c.raw || '' }));\n        list.appendChild(item);\n      });\n    } catch (e) {\n      list.innerHTML = '';\n      list.appendChild(el('div', { class: 'comment', text: 'error: ' + e.message }));\n    }\n  }\n\n  send.addEventListener('click', async () => {\n    if (!msg.value.trim()) return;\n    try {\n      await fetchJson('/api/comments', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ ticket: ticketId, author: author.value, type: typeSel.value, message: msg.value }),\n      });\n      msg.value = '';\n      refresh();\n    } catch (e) {\n      showToast('Error agregando comentario: ' + e.message, true);\n    }\n  });\n\n  await refresh();\n  openModal(wrap);\n}\n\nasync function init() {\n  await loadAllowlists();\n  await loadTickets();\n  setInterval(loadTickets, REFRESH_MS);\n}\ninit();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":211,"oldLines":6,"newStart":211,"newLines":9,"lines":[" const REFRESH_MS = 4000;"," let ticketsCache = [];"," let allowlists = { models: [], runners: [] };","+// FIX-004: survives poll-triggered re-renders (buildCard destroys/rebuilds","+// selects every REFRESH_MS); populated on change, consulted by buildCard().","+const userSelections = new Map(); // ticketId -> { runner, model }"," "," function el(tag, attrs = {}, children = []) {","   const node = document.createElement(tag);"]}],"userModified":false,"replaceAll":false}}
