rSelect.value === 'claude') {\n        modelSelect.disabled = false;\n        (allowlists.models.length ? allowlists.models : ['claude-fable-5','claude-opus-4-8','claude-sonnet-5'])\n          .forEach((m) => modelSelect.appendChild(el('option', { value: m, text: m })));\n      } else {\n        modelSelect.disabled = true;\n        modelSelect.appendChild(el('option', { value: '', text: 'n/a (codex adapter)' }));\n      }\n      if (saved && [...modelSelect.options].some((o) => o.value === saved.model)) {\n        modelSelect.value = saved.model;\n      }\n    }\n    function saveSelection() {\n      userSelections.set(ticket.id, { runner: runnerSelect.value, model: modelSelect.value });\n    }\n    runnerSelect.addEventListener('change', () => { refreshModelOptions(); saveSelection(); });\n    modelSelect.addEventListener('change', saveSelection);\n    refreshModelOptions();"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1212,"cache_read_input_tokens":47542,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1212},"output_tokens":55,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3149de6f-ce51-47f6-ab52-20d79d233131","uuid":"d39620b0-fb88-4d97-8db8-11e2986da48d"}
