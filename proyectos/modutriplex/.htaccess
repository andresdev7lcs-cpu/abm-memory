# ─────────────────────────────────────────────
# Modutriplex — configuración Apache (Hostinger)
# ─────────────────────────────────────────────

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caché de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 year"
  ExpiresByType image/webp      "access plus 1 year"
  ExpiresByType image/png       "access plus 1 year"
  ExpiresByType image/svg+xml   "access plus 1 year"
  ExpiresByType video/mp4       "access plus 1 year"
  ExpiresByType text/css        "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Range requests para streaming del video en Safari
  <FilesMatch "\.(mp4)$">
    Header set Accept-Ranges "bytes"
  </FilesMatch>
</IfModule>

# Forzar HTTPS y dominio sin www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html -> / (evita URL duplicada de la home)
  RewriteRule ^index\.html$ / [L,R=301]

  # /pagina.html -> /pagina (evita URL duplicada, un solo canonical real)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.+)\.html$ /$1 [L,R=301]

  # /pagina/ -> /pagina (el slash final no es un directorio real, daba 500)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Permitir URLs sin la extensión .html (rewrite interno, sin redirect visible)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /index.html
