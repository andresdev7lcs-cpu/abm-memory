      "credentials": {
        "googleApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Spirited Lamb Service Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Only pass through events whose date falls in the current calendar month/year.\n// Client keeps adding rows for future/past months without deleting anything;\n// this is what keeps the calendar showing just the current month.\n// Always returns exactly ONE item (events array can be empty) so the Respond\n// node downstream always executes -- n8n skips nodes entirely when a node's\n// output has zero items, which would otherwise send an empty response body.\nconst now = new Date();\nconst curMonth = now.getMonth();\nconst curYear = now.getFullYear();\n\nconst events = $input.all()\n  .filter(item => {\n    const d = new Date(item.json.date);\n    return !isNaN(d) && d.getMonth() === curMonth && d.getFullYear() === curYear;\n  })\n  .map(item => item.json);\n\nreturn [{ json: { events } }];"
      },
      "id": "filter-current-month-1",
      "name": "Filter Current Month",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 240]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-1",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [80, 240]
    }
  ],
