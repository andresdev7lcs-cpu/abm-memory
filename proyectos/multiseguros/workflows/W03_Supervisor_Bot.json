        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.estado !== undefined);\nconst hoy = new Date().toISOString().slice(0, 10);\nconst abiertos = rows.filter(c => ['abierto','en_curso','escalado'].includes(c.estado));\nconst cerradosHoy = rows.filter(c => (c.cerrado_en || '').slice(0, 10) === hoy);\nconst urgentes = abiertos.filter(c => c.prioridad === 'urgente');\nconst sinResp = abiertos.filter(c => c.alertado);\nconst t = ['Resumen ' + hoy + ':',\n '- Casos abiertos: ' + abiertos.length,\n '- Cerrados hoy: ' + cerradosHoy.length,\n '- Urgentes abiertos: ' + urgentes.length,\n '- Con SLA vencido (sin respuesta): ' + sinResp.length,\n '- Escalados activos: ' + abiertos.filter(c => c.escalado).length];\nreturn [{ json: { texto: t.join('\\n') } }];"
