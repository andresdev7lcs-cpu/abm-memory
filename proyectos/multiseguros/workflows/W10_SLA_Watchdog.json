        "method": "PATCH",
        "url": "={{ 'https://ekarbxdoaoqrtlmfzgyj.supabase.co/rest/v1/casos?id=eq.' + $('Filtrar Alertas').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_KEY_AQUI"
            },
            {
              "name": "Authorization",
