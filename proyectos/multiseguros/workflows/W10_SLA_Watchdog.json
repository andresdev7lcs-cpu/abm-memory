{
  "name": "W10 - SLA Watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "n118",
      "name": "Cron 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://ekarbxdoaoqrtlmfzgyj.supabase.co/rest/v1/casos?estado=in.(abierto,en_curso)&alertado=eq.false&sla_alerta_at=lte.' + new Date().toISOString() + '&select=id,area,tipo_requerimiento,prioridad,creado_en,asesores(nombre)&limit=50' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_KEY_AQUI"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_KEY_AQUI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "n119",
      "name": "GET Casos Por Alertar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id !== undefined);\nreturn rows.map(c => ({ json: { ...c,\n  texto: 'SLA EN RIESGO - caso #' + c.id + ' (' + c.tipo_requerimiento + ', ' + c.area + ', ' +\n    c.prioridad + ')\\nAsesor: ' + ((c.asesores && c.asesores.nombre) || 'sin asignar') +\n    '\\nAbierto desde: ' + (c.creado_en || '').slice(0, 16).replace('T', ' ') +\n    '\\nSin primera respuesta. Escala a gerencia pronto.' } }));"
      },
      "id": "n120",
      "name": "Filtrar Alertas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://no-26feb-n8n.ydlmwq.easypanel.host/webhook/msds-notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ area: 'supervisor', chat_id: '', texto: $json.texto }) }}"
      },
      "id": "n121",
      "name": "Alertar Supervisor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
