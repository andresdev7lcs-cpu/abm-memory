    {
      "parameters": {
        "jsCode": "const p = $('GET Poliza').first().json;\nconst a = $input.first().json;\nif (!p || p.id === undefined) return [{ json: { ok: false, error: 'poliza no encontrada' } }];\nconst cliente = (p.cliente && p.cliente.nombre) || 'sin cliente';\nconst prima = p.prima ? '$' + Number(p.prima).toLocaleString('es-CO') : 'sin prima';\nreturn [{ json: { ok: true,\n  asesor_id: (a && a.id) || null,\n  chat_id: a && a.telegram_chat_id ? String(a.telegram_chat_id) : '',\n  hoy: new Date().toISOString().slice(0, 10),\n  descripcion: 'Gestionar pago prima poliza ' + (p.numero || p.id) + ' - cliente ' + cliente,\n  texto: 'PENDIENTE COBRO\\nPoliza ' + (p.numero || '#' + p.id) + ' (' + (p.ramo || '?') + ')' +\n    '\\nCliente: ' + cliente + '\\nPrima: ' + prima +\n    '\\nAseguradora: ' + (p.aseguradora || '?') +\n    '\\nVendedor: ' + (p.vendedor_tipo || 'sin registrar') +\n    (p.vendedor_externo_nombre ? ' (' + p.vendedor_externo_nombre + ')' : '') +\n    '\\nSLA primer contacto: 48h' } }];"
      },
