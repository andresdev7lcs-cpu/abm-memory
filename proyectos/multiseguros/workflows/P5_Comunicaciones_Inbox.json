            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_ANON_KEY_AQUI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ canal: $json.canal, direccion: $json.direccion, remitente: $json.remitente || null, asunto: $json.asunto || null, mensaje: $json.mensaje || null, ref_externa: $json.ref_externa || null, estado: 'nueva' }) }}",
        "options": {}
      },
      "id": "p5-insertar",
      "name": "Insertar Comunicacion (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "chatId": "8695082898",
        "text": "=📨 Nueva comunicación {{ $json.canal }}\n\nDe: {{ $json.remitente || 'sin identificar' }}\n{{ $json.asunto ? 'Asunto: ' + $json.asunto + '\\n' : '' }}Mensaje: {{ ($json.mensaje || '—').slice(0, 300) }}\n\nEstado: sin responder\nVer en dashboard → Comunicaciones",
        "additionalFields": {}
      },
      "id": "p5-telegram",
      "name": "Notificar Gerente Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true, \"mensaje\": \"comunicacion registrada\"}",
        "options": {}
      },
      "id": "p5-respuesta",
