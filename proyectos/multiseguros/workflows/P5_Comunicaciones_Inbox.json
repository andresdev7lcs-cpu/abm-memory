        "options": {}
      },
      "id": "p5-normalizar",
      "name": "Normalizar Mensaje",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ekarbxdoaoqrtlmfzgyj.supabase.co/rest/v1/comunicaciones",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_ANON_KEY_AQUI"
